{{!
    @template local_ai_course_assistant/prompt_playground

    Admin prompt playground: assemble the system prompt against simulated or
    live-retrieved course content and inspect the result.

    Context variables required for this template:
    * intro string - Explanatory lead paragraph.
    * formaction string - URL the form posts to.
    * sesskey string - Session key.
    * courseid string - Current course id value, or empty.
    * pageid string - Current page (cmid) value, or empty.
    * query string - Test question.
    * simchunks string - Pasted simulated chunks.
    * labels object - Field labels: courseid, pageid, query, chunks, assemble.
    * livemode bool - Whether a live retrieval was run.
    * retrieval object|false - Live retrieval panel.
    * result object|false - Assembled prompt panel.
    * errorhtml string - Pre-rendered notification HTML, if any.

    Example context (json):
    {
        "intro": "Assemble the prompt without running a chat turn.",
        "formaction": "/local/ai_course_assistant/prompt_playground.php",
        "sesskey": "abc123",
        "courseid": "2",
        "pageid": "",
        "query": "What is opportunity cost?",
        "simchunks": "",
        "labels": {
            "courseid": "Course ID",
            "pageid": "Page (cmid)",
            "query": "Test question",
            "chunks": "Simulated chunks",
            "assemble": "Assemble prompt"
        },
        "livemode": false,
        "retrieval": false,
        "result": false,
        "errorhtml": ""
    }
}}
<div class="text-muted mb-3">{{{intro}}}</div>

<form method="post" action="{{formaction}}" class="mb-4">
    <input type="hidden" name="sesskey" value="{{sesskey}}">
    <input type="hidden" name="go" value="1">

    <div class="form-group mb-2">
        <label for="pp-courseid">{{{labels.courseid}}}</label>
        <input type="number" id="pp-courseid" name="courseid"
               class="form-control sola-pp-narrow" value="{{courseid}}" min="1" required>
    </div>
    <div class="form-group mb-2">
        <label for="pp-pageid">{{{labels.pageid}}}</label>
        <input type="number" id="pp-pageid" name="pageid"
               class="form-control sola-pp-narrow" value="{{pageid}}" min="0">
    </div>
    <div class="form-group mb-2">
        <label for="pp-query">{{{labels.query}}}</label>
        <input type="text" id="pp-query" name="query" class="form-control" value="{{query}}">
    </div>
    <div class="form-group mb-2">
        <label for="pp-chunks">{{{labels.chunks}}}</label>
        <textarea id="pp-chunks" name="simchunks" class="form-control sola-pp-mono"
                  rows="8">{{simchunks}}</textarea>
    </div>

    <button type="submit" class="btn btn-primary">{{labels.assemble}}</button>
</form>

{{#retrieval}}
    <div class="card mb-3">
        <div class="card-body">
            <h4>{{heading}}</h4>
            {{! This string carries <em> markup, so it renders unescaped; the
                interpolated query is escaped in PHP before it gets here. }}
            <p class="text-muted mb-2">{{{question}}}</p>
            {{#failed}}{{{errorhtml}}}{{/failed}}
            {{^failed}}
                {{#empty}}<p class="text-muted">{{emptytext}}</p>{{/empty}}
                {{^empty}}
                    <p class="mb-2">{{{summary}}}</p>
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>{{labelscore}}</th>
                                <th>cmid</th>
                                <th>{{labeltype}}</th>
                                <th>{{labelcontent}}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#chunks}}
                                <tr>
                                    <td>c:{{index}}</td>
                                    <td>{{score}}</td>
                                    <td>{{cmid}}</td>
                                    <td>{{modtype}}</td>
                                    <td><div class="sola-pp-chunkcell">{{content}}</div></td>
                                </tr>
                            {{/chunks}}
                        </tbody>
                    </table>
                {{/empty}}
            {{/failed}}
        </div>
    </div>
{{/retrieval}}

{{#result}}
    <div class="card mb-3">
        <div class="card-body">
            <h4>{{heading}}</h4>
            <p class="mb-2">{{{summary}}}</p>
            {{#breakdown}}
                <h5>{{breakdownheading}}</h5>
                <pre class="sola-pp-pre">{{breakdowntext}}</pre>
            {{/breakdown}}
        </div>
    </div>
    <div class="card">
        <div class="card-body">
            <h5>{{assembledheading}}</h5>
            <pre class="sola-pp-pre sola-pp-pre-tall">{{prompt}}</pre>
        </div>
    </div>
{{/result}}

{{#failedassembly}}{{{errorhtml}}}{{/failedassembly}}
