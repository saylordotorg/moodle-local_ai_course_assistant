                    <button type="submit" class="btn btn-primary">{{l.queuesubmit}}</button>
                </form>
            {{/queue.hasmodels}}
        </div>
    </div>
</div>
{{#js}}
// Destructive forms carry their prompt in data-confirm, which keeps the handler
// out of an inline onclick attribute. window.confirm() is unavailable (Moodle's
// ESLint forbids no-alert), so this uses the core save/cancel modal -- also the
// accessible, themeable option. Same handler as rag_admin.
require(['core/notification', 'core/str'], function(Notification, Str) {
    var forms = document.querySelectorAll('.sola-modelregistry form[data-confirm]');
    Array.prototype.forEach.call(forms, function(form) {
        var confirmed = false;
        form.addEventListener('submit', function(e) {
            if (confirmed) {
                return;
            }
            e.preventDefault();
            Str.get_strings([
                {key: 'confirm', component: 'moodle'},
                {key: 'yes', component: 'moodle'}
            ]).then(function(labels) {
                return Notification.saveCancelPromise(
                    labels[0],
                    form.dataset.confirm,
                    labels[1]
                );
            }).then(function() {
                confirmed = true;
                form.submit();
                return null;
            }).catch(function() {
                // Cancelled, or the modal failed to load: leave the form unsubmitted.
                return null;
            });
        });
    });
});
{{/js}}
