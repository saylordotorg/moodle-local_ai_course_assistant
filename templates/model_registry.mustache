            "hasproposal": true,
            "proposal": {"input": "0.3", "output": "2.5", "inputlabel": "$0.3",
                "outputlabel": "$2.5", "provider": "google", "capability": "chat",
                "context": "1048576", "sourcename": "LiteLLM"}
        }]},
        "effective": {"has": true, "count": 1, "rows": [{
            "modelkey": "gemini-2.5-flash", "input": "$0.3", "output": "$2.5",
            "inputraw": "0.3", "outputraw": "2.5", "layerlabel": "Shipped baseline",
            "sourcelabel": "", "intable": false, "capability": "", "context": "",
            "contextraw": "", "provider": "", "statuslabel": "", "notes": "",
            "setby": "", "updated": ""
        }]},
        "modelform": {"modelkey": "", "provider": "", "capability": "", "input_rate": "",
            "output_rate": "", "context_tokens": "", "notes": "", "editing": false,
            "statuses": [{"value": "active", "label": "Active", "selected": true}]},
        "sources": {"has": true, "rows": [{
            "id": 1, "name": "LiteLLM", "url": "https://example.org/prices.json",
            "formatlabel": "LiteLLM manifest", "spec": "", "enabled": true,
            "enabledlabel": "Yes", "lastfetch": "8/09/26, 02:30", "statusok": true,
            "statuserror": false, "statuslabel": "OK", "lastmessage": "Parsed 812 prices."
        }]},
        "sourceform": {"sourceid": 0, "name": "", "url": "", "spec": "", "enabled": false,
            "editing": false, "formats": [{"value": "litellm", "label": "LiteLLM manifest", "selected": true}]},
        "drift": {"hasrun": true, "has": true, "lastrun": "Last checked 8/09/26, 02:30.",
            "statusnote": "", "tolerance": "1", "truncated": 0,
            "counts": {"missing": 1, "mismatch": 0, "new": 0},
            "rows": [{"type": "missing", "typelabel": "Unpriced model in traffic",
                "ismissing": true, "ismismatch": false, "isnew": false,
                "modelkey": "gemini-2.5-flash", "provider": "google", "capability": "chat",
                "proposed": "$0.3 / $2.5", "registry": "", "delta": "", "calls": "18,204",
                "sourcename": "LiteLLM", "hasrates": true, "applyinput": "0.3",
                "applyoutput": "2.5", "applycontext": "1048576"}]},
        "bench": {"release": "7.4.0", "floor": 5,
            "tunables": "Thresholds in force: quality tolerance 0.02.",
            "hasunmeasured": false, "unmeasured": [],
            "cards": [{"function": "chat", "label": "Chat tutor", "modelkey": "gemini-2.5-flash",
                "current": "Currently configured: gemini / gemini-2.5-flash",
                "inherited": false, "inheritedlabel": "inherited from the site model",
                "currentmeasured": false,
                "currentquality": {"has": false, "value": "", "n": "", "belowfloor": false},
                "currentcost": "", "hascandidates": false, "candidates": [],
                "recommendation": null,
                "norecommendation": "Nothing has been benchmarked for this function yet.",
                "volumenote": "", "sharednote": "", "hasruns": false, "runs": []}]},
        "queue": {"hasmodels": true, "models": [{"value": "gemini-2.5-flash", "label": "gemini-2.5-flash (google)"}],
            "functions": [{"value": "chat", "label": "Chat tutor"}], "samples": 10, "maxsamples": 50}
