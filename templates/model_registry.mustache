{{!
    @template local_ai_course_assistant/model_registry

    Model registry admin page. Seven sections, in the order an operator needs
    them: unpriced models seen in real traffic (the state that made every
    production chat call report $0.00, so it leads and it is an alert, not a
    table row), the effective merged price list with provenance, the add/correct
    form, pricing sources, drift findings with one-click apply, benchmark
    results and recommendations including their refusals, and a benchmark queue
    form.

    Every string arrives pre-resolved in `l`; the template makes no in-template
    string lookup, because brand-bearing copy has to pass through
    branding::str in PHP, and a mustache comment cannot even name the tag it is
    avoiding without ending itself early -- which is exactly the bug that first
    printed this documentation into the page.
    Styling is Bootstrap plus the .sola-modelregistry namespace in styles.css.

    Context variables required for this template:
    * backurl, backlabel - link back to the plugin settings category.
    * posturl - action URL for every POST form.
    * pageurl - base URL for the edit links.
    * sesskey - session key for those forms.
    * l - map of every resolved label; see model_registry.php.
    * unpriced - {has, count, days, rows[{modelkey, model, provider, calls,
      tokens, lastseen, hasproposal, proposal{input, output, inputlabel,
      outputlabel, provider, capability, context, sourcename} }]}.
    * effective - {has, count, rows[{modelkey, input, output, inputraw,
      outputraw, layerlabel, sourcelabel, intable, capability, context,
      contextraw, provider, statuslabel, notes, setby, updated}]}.
    * modelform - {modelkey, provider, capability, input_rate, output_rate,
      context_tokens, notes, editing, statuses[{value, label, selected}]}.
    * sources - {has, rows[{id, name, url, formatlabel, spec, enabled,
      enabledlabel, lastfetch, statusok, statuserror, statuslabel, lastmessage}]}.
    * sourceform - {sourceid, name, url, spec, enabled, editing,
      formats[{value, label, selected}]}.
    * drift - {hasrun, has, lastrun, statusnote, tolerance, truncated,
      counts{missing, mismatch, new}, rows[...]}.
    * bench - {cards[...], unmeasured[...], hasunmeasured, release, floor,
      tunables}.
    * queue - {models[{value, label}], hasmodels, functions[{value, label}],
      samples, maxsamples}.

    Example context (json):
    {
        "backurl": "https://example.org/admin/category.php?category=local_ai_course_assistant",
        "backlabel": "Back to settings",
        "posturl": "https://example.org/local/ai_course_assistant/model_registry.php",
        "pageurl": "https://example.org/local/ai_course_assistant/model_registry.php",
        "sesskey": "abc123",
        "l": {
            "title": "Model registry and pricing",
            "intro": "Every model SOLA can bill for.",
            "unpricedheading": "Unpriced models seen in real traffic",
            "unpriceddesc": "These models appear in billable calls.",
            "unpricednone": "Every model billed resolves to a price.",
            "unpricedcount": "1 unpriced model in billable traffic",
            "priceit": "Set a price",
            "colmodel": "Model", "colprovider": "Provider", "colcalls": "Billable calls",
            "coltokens": "Tokens", "collastseen": "Last seen", "colactions": "Actions",
            "colprefix": "Model key", "colinput": "Input", "coloutput": "Output",
            "colcapability": "Capability", "colcontext": "Context", "colstatus": "Status",
            "collayer": "Supplied by", "colsource": "Source", "colsetby": "Set by",
            "colupdated": "Updated", "colquality": "Quality", "colcost": "Cost per call",
            "colttft": "First byte (p50)", "colverdict": "Verdict", "colmeasured": "Measured",
            "effectiveheading": "Effective prices", "effectivedesc": "The merged rate card.",
            "effectivenone": "No prices are resolvable.", "edit": "Edit", "delete": "Delete",
            "deleteconfirm": "Delete this row?", "manualwins": "Manual rows are never overwritten.",
            "formheading": "Add or correct a model", "formdesc": "Saving records you as the author.",
            "fieldmodelkey": "Model key", "fieldmodelkeyhelp": "Lowercase.",
            "fieldprovider": "Provider", "fieldcapability": "Capability",
            "fieldcapabilityhelp": "Free text.", "fieldinput": "Input price",
            "fieldoutput": "Output price", "fieldoutputhelp": "Include thinking tokens.",
            "fieldcontext": "Context window", "fieldstatus": "Status", "fieldnotes": "Notes",
            "fieldnoteshelp": "Where the price came from.", "save": "Save model",
            "sourcesheading": "Pricing sources", "sourcesdesc": "A source is a row.",
            "sourcesnone": "No pricing sources are configured.",
            "colname": "Name", "colurl": "URL", "colformat": "Format", "colenabled": "Enabled",
            "collastfetch": "Last fetch", "colresult": "Result",
            "sourceformheading": "Add or edit a pricing source", "fieldname": "Name",
            "fieldurl": "URL", "fieldurlhelp": "https only.", "fieldformat": "Format",
            "fieldspec": "Parse spec (JSON)", "fieldspechelp": "inputpath is required.",
            "fieldenabled": "Enabled", "savesource": "Save source",
            "enable": "Enable", "disable": "Disable",
            "driftheading": "Price drift findings", "driftdesc": "What the sources say.",
            "driftnone": "Nothing to report.", "driftrunnow": "Check for drift now",
            "drifttolerance": "Reporting differences above 1%.",
            "drifttruncated": "0 further findings were not stored.",
            "driftcolfinding": "Finding", "driftcolproposed": "Proposed (in / out)",
            "driftcolregistry": "Registry (in / out)", "driftcoldelta": "Difference",
            "driftapply": "Apply this price", "driftnosource": "No source knows this model.",
            "benchheading": "Benchmarks and recommendations",
            "benchdesc": "A recommendation compares measurements.",
            "benchnoresults": "No benchmark has been stored for this model yet.",
            "benchrecentruns": "Recent runs", "recunmeasured": "Unmeasured",
            "recunmeasuredintro": "These functions have no comparable benchmark.",
            "benchrunnow": "Benchmark this model",
            "queueheading": "Run a benchmark", "queuedesc": "Queues a run on the next cron pass.",
            "queuefieldmodel": "Registry key", "queuefieldfunction": "Function",
            "queuefieldsamples": "Prompts", "queuesubmit": "Queue this benchmark",
            "queuenoeligible": "Add a model to the registry first."
        },
        "unpriced": {"has": true, "count": 1, "days": 30, "rows": [{
            "modelkey": "gemini-2.5-flash", "model": "gemini-2.5-flash", "provider": "gemini",
