{{!
    @template local_ai_course_assistant/analytics_dashboard

    SOLA Analytics — admin-only dashboard with cross-course summary,
    per-course enable/disable toggles, and per-course drill-down.

    Example context (json):
    {
            "settings_url": "#",
            "token_analytics_url": "#",
            "analytics_base_url": "#",
            "form_action": "https://example.invalid/local/ai_course_assistant/analytics.php",
            "experiment_form_action": "https://example.invalid/local/ai_course_assistant/analytics.php",
            "meta_ai_sse_url": "https://example.invalid/local/ai_course_assistant/meta_ai_sse.php",
            "sesskey": "abc123",
            "courseid_param": 0,
            "range": 30,
            "enabled_courses": 12,
            "total_courses": 24,
            "active_courses": 9,
            "total_messages_all": 1420,
            "active_students_all": 318,
            "has_courses": false,
            "show_real_names": false,
            "student_mode": false,
            "has_meta_ai_providers": false,
            "str_scope_all": "All courses",
            "str_all_courses": "All courses",
            "str_scope_current": "Current course only",
            "str_scope_custom": "Specific course IDs…",
            "str_scope_byprovider": "By LLM provider used",
            "str_last_24_hours": "Last 24 hours",
            "str_last_7_days": "Last 7 days",
            "str_last_30_days": "Last 30 days",
            "str_last_90_days": "Last 90 days",
            "str_all_time": "All time"
    }
}}
<div class="local-ai-tutor-analytics">

    {{! Navigation + Anonymization toggle }}
    <div class="mb-3 d-flex flex-wrap align-items-center" style="gap:8px">
        <a href="{{settings_url}}" class="btn btn-sm btn-outline-secondary">&larr; {{str_plugin_settings}}</a>
        <a href="{{token_analytics_url}}" class="btn btn-sm btn-outline-secondary">&#36; {{str_token_usage_cost}}</a>
        <a href="{{export_csv_url}}" class="btn btn-sm btn-outline-secondary" title="{{str_export_csv_title}}">&#8615; {{str_export_csv}}</a>
        <div style="margin-left:auto;display:flex;gap:8px">
            <form method="post" action="{{form_action}}" style="display:inline">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <input type="hidden" name="action" value="togglenames">
                <input type="hidden" name="courseid" value="{{courseid_param}}">
                <input type="hidden" name="range" value="{{range}}">
                <button type="submit" class="btn btn-sm {{#show_real_names}}btn-warning{{/show_real_names}}{{^show_real_names}}btn-outline-secondary{{/show_real_names}}">
                    {{#show_real_names}}&#128275; {{str_hide_real_names}}{{/show_real_names}}{{^show_real_names}}&#128274; {{str_show_real_names}}{{/show_real_names}}
                </button>
            </form>
            <form method="post" action="{{form_action}}" style="display:inline">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <input type="hidden" name="action" value="togglestudentmode">
                <input type="hidden" name="courseid" value="{{courseid_param}}">
                <input type="hidden" name="range" value="{{range}}">
                <button type="submit" class="btn btn-sm {{#student_mode}}btn-info{{/student_mode}}{{^student_mode}}btn-outline-secondary{{/student_mode}}">
                    {{#student_mode}}{{str_exit_student_mode}}{{/student_mode}}{{^student_mode}}{{str_student_mode}}{{/student_mode}}
                </button>
            </form>
        </div>
    </div>
    {{#show_real_names}}
    <div class="alert alert-warning py-2 mb-3" style="font-size:13px">
        {{{str_real_names_warning}}}
    </div>
    {{/show_real_names}}
    {{#student_mode}}
    <div class="alert alert-info py-2 mb-3" style="font-size:13px">
        {{{str_student_mode_notice}}}
    </div>
    {{/student_mode}}

    {{! ═══ Header summary line ═══ }}
    <p class="text-muted small mb-3">
        {{str_courses_enabled_summary}} —
        <a href="{{courses_admin_url}}">{{str_manage_course_enrollment}} &rarr;</a>
    </p>

    {{! ═══ Learning Radar (always visible — no collapse) ═══ }}
    <div class="card mb-4 learning-radar" id="learning-radar"
         data-sse-url="{{meta_ai_sse_url}}"
         data-export-url="{{radar_export_url}}"
         data-schedule-url="{{radar_schedule_url}}"
         data-redash-url="{{redash_pull_url}}"
         data-has-redash="{{#has_redash_key}}1{{/has_redash_key}}{{^has_redash_key}}0{{/has_redash_key}}"
         data-sesskey="{{sesskey}}"
         data-courseid="{{courseid_param}}"
         data-range="{{range}}"
         data-name-prompt="{{radar_name_prompt}}"
         data-redash-name-tpl="{{radar_redash_name_tpl}}"
         data-providers='{{{meta_ai_providers_json}}}'>
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap" style="gap:8px">
            <h4 class="mb-0">{{str_radar_heading}}
                <small class="text-muted" style="font-size:13px">— {{str_radar_subtitle}}</small>
            </h4>
            <div style="display:flex;gap:6px;flex-wrap:wrap">
                <button type="button" class="btn btn-sm btn-outline-secondary" id="radar-share" title="{{str_radar_share_title}}">
                    &#128279; {{str_radar_share}}
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="radar-toggle-schedules"
                        data-bs-toggle="collapse" data-bs-target="#radar-schedules-body" aria-controls="radar-schedules-body" aria-expanded="false">
                    &#9881; {{str_radar_schedules}} (<span id="radar-schedule-count">{{radar_schedule_count}}</span>)
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="radar-toggle-history"
                        data-bs-toggle="collapse" data-bs-target="#radar-history-body" aria-controls="radar-history-body" aria-expanded="false">
                    &#128240; {{str_radar_history}}
                </button>
            </div>
        </div>
        <div class="card-body">

            {{! Suggested starters (curated, always shown) }}
            <div class="text-muted small mb-1">{{str_radar_try_question}}</div>
            <div class="learning-radar-starters" style="display:flex;flex-wrap:wrap;gap:6px;margin-bottom:12px">
                {{#learning_radar_starters}}
                <button type="button" class="learning-radar-starter btn btn-sm btn-outline-primary"
                        data-query="{{query}}"
                        style="font-size:12px;padding:4px 10px;border-radius:14px">
                    {{label}}
                </button>
                {{/learning_radar_starters}}
            </div>

            {{! Live metric chips (data-derived, click-to-query) }}
            {{#learning_radar_chips.0}}
            <div class="text-muted small mb-1">{{str_radar_click_metric}}</div>
            <div class="learning-radar-chips" style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:14px">
                {{#learning_radar_chips}}
                <button type="button"
                        class="learning-radar-chip btn btn-sm btn-outline-secondary"
                        data-query="{{query}}"
                        style="text-align:left;padding:8px 12px;background:#fff;border:1px solid #dee2e6;border-radius:6px;min-width:160px;cursor:pointer">
                    <div style="font-size:18px;font-weight:600;color:#212529;line-height:1.1">{{value}}</div>
                    <div style="font-size:11px;color:#6c757d;text-transform:uppercase;letter-spacing:0.3px;margin-top:2px">{{label}}</div>
                </button>
                {{/learning_radar_chips}}
            </div>
            {{/learning_radar_chips.0}}

            {{! Provider/model/scope/range row }}
            <div class="d-flex flex-wrap align-items-end mb-2" style="gap:8px">
                <div>
                    <label for="ai-analysis-provider" class="small text-muted mb-0">{{str_provider}}</label>
                    <select id="ai-analysis-provider" class="form-control form-control-sm" style="width:180px"></select>
                </div>
                <div>
                    <label for="ai-analysis-model" class="small text-muted mb-0">{{str_model}}</label>
                    <select id="ai-analysis-model" class="form-control form-control-sm" style="width:200px"></select>
                </div>
                <div>
                    <label for="ai-analysis-scope" class="small text-muted mb-0">{{str_data_scope}}</label>
                    <select id="ai-analysis-scope" class="form-control form-control-sm" style="width:200px">
                        <option value="all">{{str_all_courses}}</option>
                        <option value="current" {{#courseid_param}}selected{{/courseid_param}}>{{str_scope_current}}</option>
                        <option value="custom">{{str_scope_custom}}</option>
                        <option value="byprovider">{{str_scope_byprovider}}</option>
                    </select>
                </div>
                <div id="ai-analysis-scope-detail" style="display:none">
                    <label for="ai-analysis-scope-value" class="small text-muted mb-0">{{str_scope_detail_label}}</label>
                    <input type="text" id="ai-analysis-scope-value" class="form-control form-control-sm" style="width:200px" placeholder="{{str_scope_detail_placeholder}}">
                </div>
                <div>
                    <label for="ai-analysis-range-select" class="small text-muted mb-0">{{str_range}}</label>
                    <select id="ai-analysis-range-select" class="form-control form-control-sm" style="width:140px">
                        <option value="1">{{str_last_24_hours}}</option>
                        <option value="7">{{str_last_7_days}}</option>
                        <option value="30" selected>{{str_last_30_days}}</option>
                        <option value="90">{{str_last_90_days}}</option>
                        <option value="0">{{str_all_time}}</option>
                    </select>
                </div>
                <div class="form-check ml-2" style="margin-top:18px">
                    <input class="form-check-input" type="checkbox" id="ai-analysis-compare">
                    <label class="form-check-label small" for="ai-analysis-compare" title="{{str_compare_two_models_title}}">
                        {{str_compare_two_models}}
                    </label>
                </div>
            </div>

            {{! Compare-mode second provider/model (shown only when toggle is on) }}
            <div class="d-flex flex-wrap align-items-end mb-2" style="gap:8px;display:none" id="ai-analysis-compare-row">
                <div>
                    <label for="ai-analysis-provider-b" class="small text-muted mb-0">{{str_provider_b}}</label>
                    <select id="ai-analysis-provider-b" class="form-control form-control-sm" style="width:180px"></select>
                </div>
                <div>
                    <label for="ai-analysis-model-b" class="small text-muted mb-0">{{str_model_b}}</label>
                    <select id="ai-analysis-model-b" class="form-control form-control-sm" style="width:200px"></select>
                </div>
                <div class="text-muted small" style="margin-left:auto">⚠ {{str_compare_cost_warning}}</div>
            </div>

            {{! Two side-by-side message panes (right hidden when not comparing) }}
            <div id="ai-analysis-panes" style="display:flex;gap:8px;margin-bottom:12px">
                <div id="ai-analysis-messages" style="flex:1;max-height:420px;overflow-y:auto;border:1px solid #dee2e6;border-radius:6px;padding:12px;background:#f8f9fa;font-size:14px;min-width:0">
                    <p class="text-muted mb-0" style="font-size:13px">{{str_radar_intro}}</p>
                </div>
                <div id="ai-analysis-messages-b" style="display:none;flex:1;max-height:420px;overflow-y:auto;border:1px solid #dee2e6;border-radius:6px;padding:12px;background:#f8f9fa;font-size:14px;min-width:0"></div>
            </div>

            <div class="input-group">
                <input type="text" id="ai-analysis-input" class="form-control"
                       placeholder="{{str_input_placeholder}}">
                <div class="input-group-append" style="display:flex;flex-wrap:wrap;gap:0">
                    <button class="btn btn-primary" id="ai-analysis-send" type="button">{{str_send}}</button>
                    <button class="btn btn-outline-secondary dropdown-toggle" id="radar-export-toggle" type="button"
                            data-bs-toggle="dropdown" aria-expanded="false">
                        {{str_export_menu}}
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end" id="radar-export-menu">
                        <li><h6 class="dropdown-header">{{str_download}}</h6></li>
                        <li><a class="dropdown-item" data-export="json" href="#">{{str_json}}</a></li>
                        <li><a class="dropdown-item" data-export="csv" href="#">{{str_csv}}</a></li>
                        <li><a class="dropdown-item" data-export="markdown" href="#">{{str_markdown}}</a></li>
                        <li><a class="dropdown-item" data-export="pdf" href="#">{{str_pdf_print}}</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><h6 class="dropdown-header">{{str_send}}</h6></li>
                        <li><a class="dropdown-item" data-send="email" href="#">{{str_send_email}}</a></li>
                        <li><a class="dropdown-item" data-send="slack" href="#">{{str_send_slack}}</a></li>
                        <li><a class="dropdown-item" data-send="teams" href="#">{{str_send_teams}}</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><h6 class="dropdown-header">{{str_redash}}</h6></li>
                        <li><a class="dropdown-item" data-redash-push href="#">{{str_redash_push}}</a></li>
                        <li><a class="dropdown-item" data-redash-setup href="#">{{str_redash_setup}}</a></li>
                    </ul>
                    <button class="btn btn-outline-secondary" id="radar-schedule-this" type="button"
                            title="{{str_schedule_this_title}}">
                        &#128338; {{str_schedule_this}}
                    </button>
                </div>
            </div>
            <div class="text-muted small mt-1" id="radar-cost-estimate" aria-live="polite"></div>
        </div>

        {{! Saved schedules — collapsed by default }}
        <div class="collapse border-top" id="radar-schedules-body">
            <div class="card-body" id="radar-schedules-pane">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h5 class="mb-0">{{str_scheduled_queries}}</h5>
                    <button class="btn btn-sm btn-outline-primary" id="radar-new-schedule" type="button">+ {{str_new_schedule}}</button>
                </div>
                {{#has_radar_schedules}}
                <table class="table table-sm" id="radar-schedule-table">
                    <thead>
                        <tr>
                            <th>{{str_name}}</th>
                            <th>{{str_frequency}}</th>
                            <th>{{str_channels}}</th>
                            <th>{{str_last_run}}</th>
                            <th>{{str_status}}</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#radar_schedules}}
                        <tr data-id="{{id}}">
                            <td><strong>{{name}}</strong></td>
                            <td>{{frequency}}</td>
                            <td>
                                {{#recipient}}<span class="badge bg-secondary me-1" title="{{recipient}}">{{str_channel_email}}</span>{{/recipient}}
                                {{#has_slack}}<span class="badge bg-secondary me-1">{{str_channel_slack}}</span>{{/has_slack}}
                                {{#has_teams}}<span class="badge bg-secondary me-1">{{str_channel_teams}}</span>{{/has_teams}}
                            </td>
                            <td>{{last_run}}</td>
                            <td>
                                {{#last_status_class}}<span class="badge bg-{{last_status_class}}-subtle">{{last_status}}</span>{{/last_status_class}}
                                {{^last_status}}—{{/last_status}}
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-secondary radar-sched-edit" data-id="{{id}}">{{str_edit}}</button>
                                <button class="btn btn-sm btn-outline-{{#enabled}}warning{{/enabled}}{{^enabled}}success{{/enabled}} radar-sched-toggle"
                                        data-id="{{id}}" data-enabled="{{#enabled}}0{{/enabled}}{{^enabled}}1{{/enabled}}">
                                    {{#enabled}}{{str_pause}}{{/enabled}}{{^enabled}}{{str_enable}}{{/enabled}}
                                </button>
                                <button class="btn btn-sm btn-outline-danger radar-sched-delete" data-id="{{id}}">{{str_delete}}</button>
                            </td>
                        </tr>
                        {{/radar_schedules}}
                    </tbody>
                </table>
                {{/has_radar_schedules}}
                {{^has_radar_schedules}}
                <p class="text-muted mb-0">{{str_no_schedules}}</p>
                {{/has_radar_schedules}}
            </div>
        </div>

        {{! Past queries — collapsed by default, searchable }}
        <div class="collapse border-top" id="radar-history-body">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap" style="gap:8px">
                    <h5 class="mb-0">{{str_past_queries}}</h5>
                    <input type="text" id="radar-history-search" class="form-control form-control-sm" style="max-width:280px"
                           placeholder="{{str_search_placeholder}}" aria-label="{{str_search_aria}}">
                </div>
                {{#has_radar_past}}
                <table class="table table-sm table-striped" id="radar-history-table">
                    <thead>
                        <tr>
                            <th>{{str_when}}</th>
                            <th>{{str_query}}</th>
                            <th>{{str_provider}}</th>
                            <th>{{str_type}}</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#radar_past}}
                        <tr data-id="{{id}}" data-query="{{query}}">
                            <td><small class="text-muted">{{date}}</small></td>
                            <td><div style="max-width:480px">{{query}}</div></td>
                            <td><small>{{provider}}<br>{{model}}</small></td>
                            <td>
                                {{#scheduled}}<span class="badge bg-info-subtle">{{str_badge_scheduled}}</span>{{/scheduled}}
                                {{^scheduled}}<span class="badge bg-secondary-subtle">{{str_badge_adhoc}}</span>{{/scheduled}}
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-secondary radar-history-rerun" data-id="{{id}}">{{str_rerun}}</button>
                            </td>
                        </tr>
                        {{/radar_past}}
                    </tbody>
                </table>
                {{/has_radar_past}}
                {{^has_radar_past}}
                <p class="text-muted mb-0">{{str_no_queries}}</p>
                {{/has_radar_past}}
            </div>
        </div>
    </div>

    {{! Citation popover (created on first hover) is appended to body by JS. }}

    {{! ═══ Per-Course Analytics (if selected) ═══ }}
    {{#has_course_selected}}
    <hr>
    <div class="mb-2">
        <a href="{{analytics_base_url}}" class="btn btn-sm btn-outline-secondary">&larr; {{str_back_all_courses}}</a>
    </div>
    <h2>{{course.coursename}}</h2>

    {{! Time range selector }}
    <div class="mb-3">
        <span class="mr-2"><strong>{{str_time_range}}:</strong></span>
        <div class="btn-group" role="group">
            <a href="{{url_7}}" class="btn btn-sm {{#range_7_selected}}btn-primary{{/range_7_selected}}{{^range_7_selected}}btn-outline-secondary{{/range_7_selected}}">
                {{str_last_7_days}}
            </a>
            <a href="{{url_30}}" class="btn btn-sm {{#range_30_selected}}btn-primary{{/range_30_selected}}{{^range_30_selected}}btn-outline-secondary{{/range_30_selected}}">
                {{str_last_30_days}}
            </a>
            <a href="{{url_all}}" class="btn btn-sm {{#range_all_selected}}btn-primary{{/range_all_selected}}{{^range_all_selected}}btn-outline-secondary{{/range_all_selected}}">
                {{str_all_time}}
            </a>
        </div>
        <a href="{{course.token_analytics_url}}" class="btn btn-sm btn-outline-secondary ml-2">
            &#36; {{str_token_usage_cost}} &rarr;
        </a>
    </div>

    {{^course.has_data}}
    <div class="alert alert-info">{{str_no_usage_data}}</div>
    {{/course.has_data}}

    {{#course.has_data}}

    {{! Overview cards }}
    <h3>{{str_overview}}</h3>
    <div class="card-deck mb-4">
        <div class="card">
            <div class="card-body text-center">
                <h5 class="card-title text-muted">{{str_conversations}}</h5>
                <p class="display-4">{{course.overview.total_conversations}}</p>
            </div>
        </div>
        <div class="card">
            <div class="card-body text-center">
                <h5 class="card-title text-muted">{{str_messages}}</h5>
                <p class="display-4">{{course.overview.total_messages}}</p>
            </div>
        </div>
        <div class="card">
            <div class="card-body text-center">
                <h5 class="card-title text-muted">{{str_active_students}}</h5>
                <p class="display-4">{{course.overview.active_students}}</p>
            </div>
        </div>
        <div class="card">
            <div class="card-body text-center">
                <h5 class="card-title text-muted">{{str_avg_msgs_student}}</h5>
                <p class="display-4">{{course.overview.avg_messages_per_student}}</p>
            </div>
        </div>
    </div>
    <div class="card-deck mb-4">
        <div class="card">
            <div class="card-body text-center">
                <h5 class="card-title text-muted">{{str_offtopic_open}}</h5>
                <p class="display-4">{{course.overview.offtopic_open}}</p>
            </div>
        </div>
        <div class="card">
            <div class="card-body text-center">
                <h5 class="card-title text-muted">{{str_escalations}}</h5>
                <p class="display-4">{{course.overview.escalation_count}}</p>
            </div>
        </div>
        <div class="card">
            <div class="card-body text-center">
                <h5 class="card-title text-muted">{{str_study_plans}}</h5>
                <p class="display-4">{{course.overview.studyplan_adoption}}</p>
            </div>
        </div>
    </div>

    {{! Usage trend chart }}
    <h3>{{str_usage_trends}}</h3>
    <div class="card mb-4">
        <div class="card-body">
            <canvas id="aitc-usage-chart" height="80" data-daily-usage="{{course.daily_usage_json}}"></canvas>
        </div>
    </div>

    <div class="row">
        {{! Hotspots }}
        <div class="col-md-6">
            <h3>{{str_hotspots}}</h3>
            <p class="text-muted">{{str_hotspots_intro}}</p>
            {{#course.has_hotspots}}
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>{{str_section}}</th>
                        <th class="text-right">{{str_mentions}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#course.hotspots}}
                    <tr>
                        <td>{{section}}</td>
                        <td class="text-right"><span class="badge badge-warning">{{count}}</span></td>
                    </tr>
                    {{/course.hotspots}}
                </tbody>
            </table>
            {{/course.has_hotspots}}
            {{^course.has_hotspots}}
            <p class="text-muted">{{str_no_hotspots}}</p>
            {{/course.has_hotspots}}
        </div>

        {{! Common prompts }}
        <div class="col-md-6">
            <h3>{{str_common_prompts}}</h3>
            <p class="text-muted">{{str_common_prompts_intro}}</p>
            {{#course.has_common_prompts}}
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>{{str_pattern}}</th>
                        <th class="text-right">{{str_frequency}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#course.common_prompts}}
                    <tr>
                        <td><code>{{pattern}}</code></td>
                        <td class="text-right"><span class="badge badge-info">{{frequency}}</span></td>
                    </tr>
                    {{/course.common_prompts}}
                </tbody>
            </table>
            {{/course.has_common_prompts}}
