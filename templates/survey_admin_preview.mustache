{{!
    @template local_ai_course_assistant/survey_admin_preview

    Read-only preview of the survey currently in the editor: the survey title,
    then one block per question showing how it will look to a learner. Rendered
    from JavaScript by amd/src/survey_admin.js and appended to the page body.

    This replaces a dialog the old inline script built element by element with a
    style attribute on every node; the look now lives in styles.css. The old
    dialog also wrote each multiple-choice option into innerHTML, so an option
    containing markup was parsed as HTML; here every value is escaped.

    @package    local_ai_course_assistant
    @copyright  2026 Tom Caswell & David Ta / Saylor University
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later

    Example context (json):
    {
        "title": "End-of-Course Survey",
        "closelabel": "Close preview",
        "questions": [
            {
                "number": 1,
                "text": "How often did you use the AI tutor in this course?",
                "ismultiplechoice": true,
                "options": [{"label": "Daily"}, {"label": "Never"}],
                "israting": false,
                "hasminlabel": false,
                "minlabel": "",
                "hasmaxlabel": false,
                "maxlabel": "",
                "dots": [],
                "isopentext": false,
                "answerhint": "The learner types an answer here."
            }
        ]
    }
}}
<div class="sola-sq-preview-overlay">
    <div class="sola-sq-preview-panel">
        <h4 class="sola-sq-preview-title">{{title}}</h4>
        {{#questions}}
        <div class="sola-sq-preview-question">
            <p class="sola-sq-preview-qtext">{{number}}. {{text}}</p>
            {{#ismultiplechoice}}
            {{#options}}
            <div class="sola-sq-preview-option">
                <span class="sola-sq-preview-radio"></span>{{label}}
            </div>
            {{/options}}
            {{/ismultiplechoice}}
            {{#israting}}
            <div class="sola-sq-preview-scale">
                {{#hasminlabel}}<span class="sola-sq-preview-endlabel">{{minlabel}}</span>{{/hasminlabel}}
                {{#dots}}<span class="sola-sq-preview-dot">{{n}}</span>{{/dots}}
                {{#hasmaxlabel}}<span class="sola-sq-preview-endlabel">{{maxlabel}}</span>{{/hasmaxlabel}}
            </div>
            {{/israting}}
            {{#isopentext}}
            <div class="sola-sq-preview-textbox">
                <span class="sola-sq-preview-hint">{{answerhint}}</span>
            </div>
            {{/isopentext}}
        </div>
        {{/questions}}
        <button type="button" class="btn btn-sm btn-outline-secondary sola-sq-preview-close">{{closelabel}}</button>
    </div>
</div>
