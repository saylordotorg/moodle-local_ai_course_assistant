{{!
    @template local_ai_course_assistant/analytics_tab_usagetypes

    Usage Types tab of the analytics dashboard. Replaces the innerHTML string
    that amd/src/analytics_dashboard.js used to build for this pane
    (CONTRIB-10574 #278).

    The three column headings are still literal English, exactly as they were
    in the JavaScript this replaces.

    Context variables required for this template:
    * rows - one entry per usage type, each with name, count and pct

    Example context (json):
    {
        "rows": [
            {"name": "Chat", "count": "612", "pct": "74.3%"},
            {"name": "Practice Quiz", "count": "118", "pct": "14.3%"}
        ]
    }
}}
<div class="row">
    <div class="col-md-6">
        <canvas id="sola-chart-usagetypes" height="200"></canvas>
    </div>
    <div class="col-md-6">
        <table class="table table-sm mt-3">
            <thead>
                <tr>
                    <th>Type</th>
                    <th>Count</th>
                    <th>%</th>
                </tr>
            </thead>
            <tbody>
                {{#rows}}
                    <tr>
                        <td>{{name}}</td>
                        <td>{{count}}</td>
                        <td>{{pct}}</td>
                    </tr>
                {{/rows}}
            </tbody>
        </table>
    </div>
</div>
