<div class="aica-course-settings" data-config="{{configjson}}">

    <div class="mb-3 d-flex flex-wrap sola-cs-linkbar">
        {{#navlinks}}
        <a href="{{url}}" class="btn btn-sm btn-outline-secondary">{{#back}}&larr; {{/back}}{{label}}</a>
        {{/navlinks}}
    </div>

    <form method="post" action="{{formaction}}">
        <input type="hidden" name="sesskey" value="{{sesskey}}">

        <div class="mb-3">
            <button type="submit" class="btn btn-primary">{{savelabel}}</button>
            <a href="{{cancelurl}}" class="btn btn-secondary ml-2">{{cancellabel}}</a>
        </div>

        <div class="alert alert-info sola-cs-howitworks">
            <strong>{{howitworks}}</strong>
            {{howitworksdesc}}
        </div>

        <div class="card mb-3">
            <div class="card-header">
                <h5 class="mb-0">{{solaenabledtitle}}</h5>
            </div>
            <div class="card-body">
                <p class="text-muted">{{solaenableddesc}}</p>
                <div class="form-group row mb-0">
                    <label class="col-sm-3 col-form-label">{{solaenabledtitle}}</label>
                    <div class="col-sm-9">
                        <div>
                            <input type="checkbox" role="switch"
                                   id="aica-sola-course-enabled" name="sola_course_enabled" value="1"
                                   {{#solacourseenabled}}checked{{/solacourseenabled}}>
                            <label class="form-check-label" for="aica-sola-course-enabled">
                                {{solaenabledtoggle}}
                            </label>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header">
                <h5 class="mb-0">{{title}}</h5>
            </div>
            <div class="card-body">
                <p class="text-muted">{{enableddesc}}</p>

                {{! Enable override. }}
                <div class="form-group row">
                    <label class="col-sm-3 col-form-label">{{enabledlabel}}</label>
                    <div class="col-sm-9">
                        <div>
                            <input type="checkbox" role="switch"
                                   id="aica-enabled" name="enabled" value="1"
                                   {{#enabled}}checked{{/enabled}}>
                            <label class="form-check-label" for="aica-enabled">{{enabledlabel}}</label>
                        </div>
                        <small class="form-text text-muted">
                            {{usingglobal}}
                            &mdash;
                            <a href="{{globalsettingsurl}}">{{globalsettingslabel}}</a>
                        </small>
                    </div>
                </div>

                {{! Provider. }}
                <div class="form-group row">
                    <label class="col-sm-3 col-form-label" for="provider">{{providerlabel}}</label>
                    <div class="col-sm-9">
                        {{#providerselect}}
                        {{> local_ai_course_assistant/course_settings_select}}
                        {{/providerselect}}
                    </div>
                </div>

                {{! Monthly spend cap. }}
                <div class="form-group row">
                    <label class="col-sm-3 col-form-label" for="spend_cap_monthly">{{spendcaplabel}}</label>
                    <div class="col-sm-9">
                        <input type="number" step="0.01" min="0" class="form-control" id="spend_cap_monthly"
                               name="spend_cap_monthly" value="{{spendcapvalue}}">
                        <small class="form-text text-muted">{{spendcapdesc}}</small>
                    </div>
                </div>

                {{!
                    API key. The stored credential is never rendered: the field
                    always ships empty and a blank submission keeps whatever is
                    stored. Clearing goes through the checkbox below.
                }}
                <div class="form-group row">
                    <label class="col-sm-3 col-form-label" for="apikey">{{apikeylabel}}</label>
                    <div class="col-sm-9">
                        <input type="password" class="form-control" id="apikey" name="apikey"
                               value="" autocomplete="new-password"
                               placeholder="{{apikeyplaceholder}}">
                        {{#haskey}}
                        <div class="form-check mt-2">
                            <input class="form-check-input" type="checkbox" value="1"
                                   id="apikey_clear" name="apikey_clear">
                            <label class="form-check-label" for="apikey_clear">{{apikeyclearlabel}}</label>
                        </div>
                        {{/haskey}}
                        <small class="form-text text-muted">{{apikeydesc}}</small>
                    </div>
                </div>

                {{! Model. }}
                <div class="form-group row">
                    <label class="col-sm-3 col-form-label" for="model">{{modellabel}}</label>
                    <div class="col-sm-9">
                        <input type="text" class="form-control" id="model" name="model"
                               value="{{modelvalue}}" placeholder="{{modelplaceholder}}">
                        <small class="form-text text-muted">{{modeldesc}}</small>
                    </div>
                </div>

                {{! API base URL. }}
                <div class="form-group row">
                    <label class="col-sm-3 col-form-label" for="apibaseurl">{{apibaseurllabel}}</label>
                    <div class="col-sm-9">
                        <input type="text" class="form-control" id="apibaseurl" name="apibaseurl"
                               value="{{apibaseurlvalue}}" placeholder="{{apibaseurlplaceholder}}">
                        <small class="form-text text-muted">{{apibaseurldesc}}</small>
                    </div>
                </div>

                {{! Temperature. }}
                <div class="form-group row">
                    <label class="col-sm-3 col-form-label" for="temperature">{{temperaturelabel}}</label>
                    <div class="col-sm-9">
                        <input type="number" class="form-control" id="temperature" name="temperature"
                               min="0" max="2" step="0.1"
                               value="{{temperaturevalue}}" placeholder="{{temperatureplaceholder}}">
                        <small class="form-text text-muted">{{temperaturedesc}}</small>
                    </div>
                </div>

                {{! System prompt. }}
                <div class="form-group row">
                    <label class="col-sm-3 col-form-label" for="systemprompt">{{systempromptlabel}}</label>
                    <div class="col-sm-9">
                        <textarea class="form-control" id="systemprompt" name="systemprompt" rows="6"
                                  placeholder="{{usingglobal}}">
{{systempromptvalue}}</textarea>
                        <div class="d-flex align-items-center mt-1 sola-cs-prompt-actions">
                            <small class="form-text text-muted mb-0">{{systemprompthint}}</small>
                            <button type="button" class="btn btn-sm btn-outline-secondary" id="btn-reset-prompt"
                                    title="{{resetprompttitle}}">{{resetpromptlabel}}</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {{#showrag}}
        <div class="card mb-3">
            <div class="card-header">
                <h5 class="mb-0">{{ragtitle}}</h5>
            </div>
            <div class="card-body">
                <p class="text-muted">{{ragdesc}}</p>
                <div class="form-group row">
                    <label class="col-sm-3 col-form-label" for="aica-rag-course-enabled">{{ragtitle}}</label>
                    <div class="col-sm-9">
                        <div>
                            <input type="checkbox" role="switch"
                                   id="aica-rag-course-enabled" name="rag_course_enabled" value="1"
                                   {{#ragcourseenabled}}checked{{/ragcourseenabled}}>
                            <label class="form-check-label" for="aica-rag-course-enabled">
                                {{ragenablelabel}}
                            </label>
                        </div>
                    </div>
                </div>
                <div class="form-group row mt-2">
                    <div class="col-sm-9 offset-sm-3">
                        <a href="{{ragadminurl}}" class="btn btn-sm btn-outline-secondary"
                           target="_blank">{{ragadminlabel}} &rarr;</a>
                        <a href="{{objectivesurl}}" class="btn btn-sm btn-outline-secondary ml-2"
                           target="_blank">{{objectiveslabel}} &rarr;</a>
                        {{#showdashboardlink}}
                        <a href="{{dashboardurl}}" class="btn btn-sm btn-outline-secondary ml-2"
                           target="_blank">{{dashboardlabel}} &rarr;</a>
                        {{/showdashboardlink}}
                    </div>
                </div>

                {{! Socratic mode. }}
                <div class="form-group row mt-3">
                    <label class="col-sm-3 col-form-label" for="aica-socratic-mode">{{socratictitle}}</label>
                    <div class="col-sm-9">
                        {{#socraticselect}}
                        {{> local_ai_course_assistant/course_settings_select}}
                        {{/socraticselect}}
                        <small class="form-text text-muted">{{socratichelp}}</small>
                    </div>
                </div>

                {{! Flashcards. }}
                <div class="form-group row mt-2">
                    <label class="col-sm-3 col-form-label" for="aica-flashcards-on">{{flashcardstitle}}</label>
                    <div class="col-sm-9">
                        {{#flashcardsselect}}
                        {{> local_ai_course_assistant/course_settings_select}}
                        {{/flashcardsselect}}
                        <small class="form-text text-muted">{{flashcardshelp}}</small>
                        {{#showflashcardslink}}
                        <div class="mt-1">
                            <a href="{{flashcardsurl}}" class="btn btn-sm btn-outline-secondary"
                               target="_blank">{{flashcardslinklabel}} &rarr;</a>
                        </div>
                        {{/showflashcardslink}}
                    </div>
                </div>

                {{! Python code sandbox. }}
                <div class="form-group row mt-2">
                    <label class="col-sm-3 col-form-label" for="aica-sandbox-on">{{sandboxtitle}}</label>
                    <div class="col-sm-9">
                        {{#sandboxselect}}
                        {{> local_ai_course_assistant/course_settings_select}}
                        {{/sandboxselect}}
                        <small class="form-text text-muted">{{sandboxhelp}}</small>
                        {{#sandboxavailable}}
                        <div class="mt-1">
                            <a href="{{sandboxurl}}" class="btn btn-sm btn-outline-secondary"
                               target="_blank">{{sandboxlinklabel}} &rarr;</a>
                        </div>
                        {{/sandboxavailable}}
                        {{#showsandboxwarning}}
                        <div class="mt-1 text-warning">{{sandboxnoruntime}}</div>
                        {{/showsandboxwarning}}
                    </div>
                </div>

                {{! Essay feedback. }}
                <div class="form-group row mt-2">
                    <label class="col-sm-3 col-form-label" for="aica-essay-on">{{essaytitle}}</label>
                    <div class="col-sm-9">
                        {{#essayselect}}
                        {{> local_ai_course_assistant/course_settings_select}}
                        {{/essayselect}}
                        <small class="form-text text-muted">{{essayhelp}}</small>
                        {{#showessaylink}}
                        <div class="mt-1">
                            <a href="{{essayurl}}" class="btn btn-sm btn-outline-secondary"
                               target="_blank">{{essaylinklabel}} &rarr;</a>
                        </div>
                        {{/showessaylink}}
                    </div>
                </div>

                {{! Soapbox speech practice. }}
                <div class="form-group row mt-2">
                    <label class="col-sm-3 col-form-label" for="aica-soapbox-on">{{soapboxtitle}}</label>
                    <div class="col-sm-9">
                        {{#soapboxselect}}
                        {{> local_ai_course_assistant/course_settings_select}}
                        {{/soapboxselect}}
                        <small class="form-text text-muted">{{soapboxhelp}}</small>
                        {{#showsoapbox}}
                        <div class="mt-2">
                            <label for="aica-soapbox-level" class="sola-cs-level-label">{{soapboxlevellabel}}</label>
                            {{#soapboxlevelselect}}
                            {{> local_ai_course_assistant/course_settings_select}}
                            {{/soapboxlevelselect}}
                            <small class="form-text text-muted">{{soapboxlevelhelp}}</small>
                        </div>
                        <div class="mt-2 d-flex flex-wrap sola-cs-linkrow">
                            <a href="{{soapboxurl}}" class="btn btn-sm btn-outline-secondary"
                               target="_blank">{{soapboxlinklabel}} &rarr;</a>
                            <a href="{{soapboxrubricurl}}" class="btn btn-sm btn-outline-secondary"
                               target="_blank">{{soapboxrubriclabel}} &rarr;</a>
                        </div>
                        {{/showsoapbox}}
                    </div>
                </div>

                {{! Worked examples. }}
                <div class="form-group row mt-2">
                    <label class="col-sm-3 col-form-label" for="aica-we-on">{{wetitle}}</label>
                    <div class="col-sm-9">
                        {{#weselect}}
                        {{> local_ai_course_assistant/course_settings_select}}
                        {{/weselect}}
                        <small class="form-text text-muted">{{wehelp}}</small>
                    </div>
                </div>

                {{! Weekly digest email. }}
                <div class="form-group row mt-2">
                    <label class="col-sm-3 col-form-label">{{digesttitle}}</label>
                    <div class="col-sm-9">
                        <div>
                            <input type="checkbox" role="switch"
                                   id="aica-digest-email" name="digest_email" value="1"
                                   {{#digeston}}checked{{/digeston}}>
                            <label class="form-check-label" for="aica-digest-email">{{digesttoggle}}</label>
                        </div>
                        <small class="form-text text-muted">{{digesthelp}}</small>
                    </div>
                </div>

                {{! External resources opt-in. }}
                <div class="form-group row mt-2">
                    <label class="col-sm-3 col-form-label" for="aica-extres">{{extrestitle}}</label>
                    <div class="col-sm-9">
                        {{#extresselect}}
                        {{> local_ai_course_assistant/course_settings_select}}
                        {{/extresselect}}
                        <small class="form-text text-muted">{{extreshelp}}</small>
                    </div>
                </div>
            </div>
        </div>
        {{/showrag}}

        {{#showsupplemental}}
        <div class="card mb-3">
            <div class="card-header">
                <h5 class="mb-0">{{supplementalheading}}</h5>
            </div>
            <div class="card-body">
                <p class="text-muted">{{supplementaldesc}}</p>
                <div class="form-group row">
                    <label class="col-sm-3 col-form-label" for="supplemental_courses">{{supplementallabel}}</label>
                    <div class="col-sm-9">
                        <input type="text" class="form-control" id="supplemental_courses"
                               name="supplemental_courses" value="{{supplementalvalue}}"
                               placeholder="{{supplementalplaceholder}}">
                        <small class="form-text text-muted">{{supplementalhelp}}</small>
                    </div>
                </div>
            </div>
        </div>
        {{/showsupplemental}}

        <div class="card mb-3">
            <div class="card-header">
                <h5 class="mb-0">{{englishlockheading}}</h5>
            </div>
            <div class="card-body">
                <p class="text-muted">{{englishlockdesc}}</p>
                <div class="form-group row">
                    <label class="col-sm-3 col-form-label" for="aica-english-lock">{{englishlocklabel}}</label>
                    <div class="col-sm-9">
                        <div>
                            <input type="checkbox" role="switch"
                                   id="aica-english-lock" name="english_lock" value="1"
                                   {{#englishlockenabled}}checked{{/englishlockenabled}}>
                            <label class="form-check-label" for="aica-english-lock">{{englishlocktoggle}}</label>
                        </div>
                        <small class="form-text text-muted">{{englishlockhelp}}</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header">
                <h5 class="mb-0">{{voicetabtitle}}</h5>
            </div>
            <div class="card-body">
                {{!
                    voicetabdesc is built in PHP from a lang string whose {$a}
                    placeholder is filled with a <strong>-wrapped state word, so
                    it is markup the page assembled itself, not user input.
                }}
                <p class="text-muted">{{{voicetabdesc}}}</p>
                <div class="form-group row">
                    <label class="col-sm-3 col-form-label" for="voice_tab">{{voicetabtitle}}</label>
                    <div class="col-sm-9">
                        {{#voicetabselect}}
                        {{> local_ai_course_assistant/course_settings_select}}
                        {{/voicetabselect}}
                        <small class="form-text text-muted">{{voicetabhelp}}</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header">
                <h5 class="mb-0">{{autoopenheading}}</h5>
            </div>
            <div class="card-body">
                {{!
                    autoopendesc carries the same PHP-built <strong> state word
                    as voicetabdesc above, so it is emitted unescaped too.
                }}
                <p class="text-muted">{{{autoopendesc}}}</p>
                <div class="form-group row">
                    <label class="col-sm-3 col-form-label" for="auto_open">{{autoopenlabel}}</label>
                    <div class="col-sm-9">
                        {{#autoopenselect}}
                        {{> local_ai_course_assistant/course_settings_select}}
                        {{/autoopenselect}}
                        <small class="form-text text-muted">{{autoopenhelp}}</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header">
                <h5 class="mb-0">{{starterssection}}</h5>
            </div>
            <div class="card-body">
                <p class="text-muted">{{startersdesc}}</p>
                {{#starters}}
                <div class="form-group row mb-1">
                    <label class="col-sm-5 col-form-label" for="{{paramname}}">
                        {{name}}
                        {{#hasdescription}}
                        <small class="text-muted d-block">{{description}}</small>
                        {{/hasdescription}}
                    </label>
                    <div class="col-sm-7">
                        <div>
                            <input type="checkbox" role="switch"
                                   id="{{paramname}}" name="{{paramname}}" value="1"
                                   {{#enabled}}checked{{/enabled}}>
                            <label class="form-check-label" for="{{paramname}}"></label>
                        </div>
                    </div>
                </div>
                {{/starters}}
                <div class="mt-2">
                    <a href="{{starteradminurl}}" class="btn btn-sm btn-outline-secondary"
                       target="_blank">{{starteradminlabel}} &rarr;</a>
                </div>
            </div>
        </div>

        {{#showquizzes}}
        <div class="card mb-3">
            <div class="card-header">
                <h5 class="mb-0">{{quiztitle}}</h5>
            </div>
            <div class="card-body">
                <p class="text-muted">{{quizdesc}}</p>
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>{{quizcolquiz}}</th>
                            <th>{{quizcolgrade}}</th>
                            <th>{{quizcollevel}}</th>
                            <th>{{quizcoleffective}}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#quizrows}}
                        <tr>
                            <td>{{name}}</td>
                            <td>
                                {{#hasgrade}}{{grade}}{{/hasgrade}}
                                {{^hasgrade}}<span class="text-muted">{{ungraded}}</span>{{/hasgrade}}
                            </td>
                            <td>
                                {{#levelselect}}
                                {{> local_ai_course_assistant/course_settings_select}}
                                {{/levelselect}}
                            </td>
                            <td><span class="badge bg-secondary">{{effective}}</span></td>
                        </tr>
                        {{/quizrows}}
                    </tbody>
                </table>
            </div>
        </div>
        {{/showquizzes}}

        <div class="card mb-3">
            <div class="card-header">
                <h5 class="mb-0">{{tokenusagetitle}}</h5>
            </div>
            <div class="card-body">
                <p class="text-muted">{{tokenusagedesc}}</p>
                <a href="{{tokenusageurl}}" class="btn btn-sm btn-outline-secondary"
                   target="_blank">{{tokenusagetitle}} &rarr;</a>
            </div>
        </div>

        <button type="submit" class="btn btn-primary">{{savelabel}}</button>
        <a href="{{cancelurl}}" class="btn btn-secondary ml-2">{{cancellabel}}</a>
    </form>
</div>
