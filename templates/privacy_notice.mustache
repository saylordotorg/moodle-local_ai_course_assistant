{{!
    @template local_ai_course_assistant/privacy_notice

    Default branded privacy notice. Replaces the inline HTML echoed by
    privacy.php with a template rendered through the Output API
    (CONTRIB-10574 #78). Admins can still override the whole notice via the
    privacy_notice_override setting. All prose comes from privacynotice:*
    lang strings, resolved (branding tokens included) in privacy.php.

    Context variables required for this template:
    * title, lastupdated - heading + "Last updated" line (pre-resolved strings)
    * whatisheading, whatisp1, whatisp2 - "What X Is" section
    * collectsheading, collectsp1, collectsp2 - data collection section
    * usesheading, usesitem1-5, usesnosell - "How Your Information Is Used"
    * whoseesheading, whoseesintro, shareditem1-5, whoseesnever,
      notshareditem1-5, whoseescontract - "Who Sees Your Information"
    * retentionheading, retentionitem1-4, retentiondeletion - retention section
    * rightsheading, rights{access,download,delete,correction,object,
      portability,complaint} + ...desc - "Your Rights" term/description pairs
    * internationalheading, internationalbody - international learners
    * securityheading, securityintro, security{transit,rest,incident} +
      ...desc - security term/description pairs
    * childrenheading, childrenbody - children section
    * contactheading, contactwidget - contact section
    * contactemail, privacyurl - raw values gating the contact lines
    * contactemailline, privacypageline - pre-built HTML contact lines (links)

    Example context (json):
    {
        "title": "Saylor Online Learning Assistant Privacy Notice",
        "lastupdated": "Last updated: 17 June 2026. Version 1.0.",
        "whatisheading": "What SOLA Is",
        "whatisp1": "SOLA is Saylor University's AI powered learning coach...",
        "contactemail": "privacy@example.org",
        "contactemailline": "Saylor University Contact: <a href=\"mailto:privacy@example.org\">privacy@example.org</a>",
        "privacyurl": "https://example.org/privacy",
        "privacypageline": "Saylor University Privacy Page: <a href=\"https://example.org/privacy\" target=\"_blank\" rel=\"noopener\">https://example.org/privacy</a>",
        "contactwidget": "Within SOLA: open the widget, click the gear icon, open the Privacy and data section."
    }
}}
<div class="sola-privacy-notice">

<h2>{{title}}</h2>
<p><em>{{lastupdated}}</em></p>

<h3>{{whatisheading}}</h3>
<p>{{whatisp1}}</p>
<p>{{whatisp2}}</p>

<h3>{{collectsheading}}</h3>
<p>{{collectsp1}}</p>
<p>{{collectsp2}}</p>

<h3>{{usesheading}}</h3>
<ol>
    <li>{{usesitem1}}</li>
    <li>{{usesitem2}}</li>
    <li>{{usesitem3}}</li>
    <li>{{usesitem4}}</li>
    <li>{{usesitem5}}</li>
</ol>
<p>{{usesnosell}}</p>

<h3>{{whoseesheading}}</h3>
<p>{{whoseesintro}}</p>
<ul>
    <li>{{shareditem1}}</li>
    <li>{{shareditem2}}</li>
    <li>{{shareditem3}}</li>
    <li>{{shareditem4}}</li>
    <li>{{shareditem5}}</li>
</ul>
<p>{{whoseesnever}}</p>
<ul>
    <li>{{notshareditem1}}</li>
    <li>{{notshareditem2}}</li>
    <li>{{notshareditem3}}</li>
    <li>{{notshareditem4}}</li>
    <li>{{notshareditem5}}</li>
</ul>
<p>{{whoseescontract}}</p>

<h3>{{retentionheading}}</h3>
<ul>
    <li>{{retentionitem1}}</li>
    <li>{{retentionitem2}}</li>
    <li>{{retentionitem3}}</li>
    <li>{{retentionitem4}}</li>
</ul>
<p>{{retentiondeletion}}</p>

<h3>{{rightsheading}}</h3>
<ol>
    <li><strong>{{rightsaccess}}</strong> {{rightsaccessdesc}}</li>
    <li><strong>{{rightsdownload}}</strong> {{rightsdownloaddesc}}</li>
    <li><strong>{{rightsdelete}}</strong> {{rightsdeletedesc}}</li>
    <li><strong>{{rightscorrection}}</strong> {{rightscorrectiondesc}}</li>
    <li><strong>{{rightsobject}}</strong> {{rightsobjectdesc}}</li>
    <li><strong>{{rightsportability}}</strong> {{rightsportabilitydesc}}</li>
    <li><strong>{{rightscomplaint}}</strong> {{rightscomplaintdesc}}</li>
</ol>

<h3>{{internationalheading}}</h3>
<p>{{internationalbody}}</p>

<h3>{{securityheading}}</h3>
<p>{{securityintro}}</p>
<ul>
    <li><strong>{{securitytransit}}</strong> {{securitytransitdesc}}</li>
    <li><strong>{{securityrest}}</strong> {{securityrestdesc}}</li>
    <li><strong>{{securityincident}}</strong> {{securityincidentdesc}}</li>
</ul>

<h3>{{childrenheading}}</h3>
<p>{{childrenbody}}</p>

<h3>{{contactheading}}</h3>
<ul>
    {{#contactemail}}
    <li>{{{contactemailline}}}</li>
    {{/contactemail}}
    {{#privacyurl}}
    <li>{{{privacypageline}}}</li>
    {{/privacyurl}}
    <li>{{contactwidget}}</li>
</ul>

</div>
