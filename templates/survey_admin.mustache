{{!
    @template local_ai_course_assistant/survey_admin

    End-of-course survey admin page: scope picker, survey title field, the
    save/preview/reset action bar, and the empty container that
    amd/src/survey_admin.js fills with question cards.

    All strings are resolved in PHP (survey_admin.php); there are no str helpers
    here, and every value is escaped. The editor's own data (questions and the
    client-side strings) rides on the root element's data-config attribute as
    JSON rather than as js_call_amd arguments, which have a 1 KB advisory limit
    a survey comfortably exceeds.

    @package    local_ai_course_assistant
    @copyright  2026 Tom Caswell & David Ta / Saylor University
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later

    Example context (json):
    {
        "configjson": "{}",
        "settingsurl": "/admin/category.php?category=local_ai_course_assistant",
        "settingslabel": "Plugin settings",
        "analyticsurl": "/local/ai_course_assistant/analytics.php",
        "analyticslabel": "Analytics dashboard",
        "scopeformaction": "/local/ai_course_assistant/survey_admin.php",
        "scopelabel": "Editing survey for:",
        "scopeglobal": "Global default (all courses)",
        "globalselected": true,
        "courses": [
            {"id": 2, "label": "Test Course 101 (TEST101)", "selected": false}
        ],
        "isinherited": true,
        "inheritednotice": "This course has no custom survey. Showing the global default.",
        "formaction": "/local/ai_course_assistant/survey_admin.php?courseid=0",
        "sesskey": "abc123",
        "titlelabel": "Survey title",
        "title": "End-of-Course Survey",
        "titleplaceholder": "End-of-Course Survey",
        "addquestion": "+ Add question",
        "savelabel": "Save survey",
        "previewlabel": "Preview",
        "hasreset": true,
        "resetlabel": "Reset to defaults"
    }
}}
<div class="aica-survey-admin" data-config="{{configjson}}">

    <div class="mb-3 d-flex flex-wrap sola-sq-linkbar">
        <a href="{{settingsurl}}" class="btn btn-sm btn-outline-secondary">&larr; {{settingslabel}}</a>
        <a href="{{analyticsurl}}" class="btn btn-sm btn-outline-secondary">{{analyticslabel}}</a>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <form method="get" action="{{scopeformaction}}" class="form-inline sola-sq-scope-form">
                <label for="aica-scope-select" class="sola-sq-scope-label">{{scopelabel}}</label>
                <select id="aica-scope-select" name="courseid" class="form-control form-control-sm sola-sq-scope-select">
                    <option value="0" {{#globalselected}}selected{{/globalselected}}>{{scopeglobal}}</option>
                    {{#courses}}
                    <option value="{{id}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                    {{/courses}}
                </select>
            </form>
        </div>
    </div>

    {{#isinherited}}
    <div class="aica-sq-inherited-badge">{{inheritednotice}}</div>
    {{/isinherited}}

    <form method="post" action="{{formaction}}" id="aica-survey-form">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <input type="hidden" name="action" value="save">
        <input type="hidden" name="survey_active" value="1">
        <input type="hidden" name="questions_json" id="aica-questions-json" value="">

        <div class="aica-sq-field mb-3">
            <label for="aica-survey-title">{{titlelabel}}</label>
            <input type="text" id="aica-survey-title" name="survey_title"
                   value="{{title}}" placeholder="{{titleplaceholder}}">
        </div>

        <div id="aica-questions-container"></div>

        <div class="aica-sq-add-question" id="aica-add-question-btn">{{addquestion}}</div>

        <div class="d-flex flex-wrap sola-sq-actions-row">
            <button type="submit" class="btn btn-primary">{{savelabel}}</button>
            <button type="button" class="btn btn-outline-secondary" id="aica-preview-btn">{{previewlabel}}</button>
            {{#hasreset}}
            <button type="button" class="btn btn-outline-danger" id="aica-reset-btn">{{resetlabel}}</button>
            {{/hasreset}}
        </div>
    </form>

    <form method="post" action="{{formaction}}" id="aica-reset-form" class="sola-sq-hidden">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <input type="hidden" name="action" value="reset">
    </form>
</div>
