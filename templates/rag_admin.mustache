{{!
    @template local_ai_course_assistant/rag_admin

    RAG index admin page: which content extractors are ready, site-wide index
    totals, and a per-course reindex / clear table. All styling lives in the
    plugin's styles.css under the .sola-ragadmin namespace.

    Context variables required for this template:
    * backurl - Link back to the plugin settings category.
    * backlabel - Label for that link.
    * sourcestitle - Heading of the content-source card.
    * sourcesdesc - Trusted HTML blurb under that heading (carries a settings link).
    * statusrows - List of {label, ok, statelabel, detail} extractor rows; detail
      is trusted HTML built from lang strings.
    * statcards - List of {value, label} summary cards.
    * storageprojection - Optional sentence estimating storage at other precisions.
    * posturl - Action URL for every POST form on the page.
    * sesskey - Session key for those forms.
    * reindexall - Label for the reindex-all button.
    * reindexallconfirm - Confirm prompt for the reindex-all button.
    * reindexalldesc - Explanation next to the reindex-all button.
    * indexstatus - Heading above the per-course table.
    * nocourses - Message shown when there is nothing to list.
    * hascourses - Whether any course rows are present.
    * colcourse, colchunks, colembedded, collastindexed, colactions - Table headers.
    * never - Label used when a course has never been indexed.
    * reindex - Label for the per-course reindex button.
    * clearindex - Label for the per-course clear button.
    * clearconfirm - Confirm prompt for the clear button.
    * courses - List of {id, fullname, courseurl, chunks, haschunks, embedded,
      hasembedded, lastindexed, hasindexed} rows.
    * migration - v7.4.0 embedding-model migration. {configured} is false (and
      the whole section is omitted) unless a target model is configured. When
      true it also carries heading, desc, summary (trusted HTML), sameaslive,
      progress, allcomplete, rows[{id, fullname, chunks, migrated, state,
      statelabel, complete, pending, canqueue}], hasrows, the column labels,
      queueone/queueall/queueallconfirm, the purge block (purgeheading,
      purgedesc, haspurge, purgenone, purge, purgeconfirm) and the FAQ block
      (faqheading, faqstate, faqstale, faqreembed).

    Example context (json):
    {
        "backurl": "https://example.org/admin/category.php?category=local_ai_course_assistant",
        "backlabel": "Back to plugin settings",
        "sourcestitle": "Content sources",
        "sourcesdesc": "Each row shows a content type the indexer can extract.",
        "statusrows": [{"label": "PDF (mod_resource)", "ok": true, "statelabel": "Ready", "detail": "On. pdftotext binary found."}],
        "statcards": [{"value": "3", "label": "Courses indexed"}],
        "storageprojection": "At a lower precision this index would occupy about 128 MB.",
        "posturl": "https://example.org/local/ai_course_assistant/rag_admin.php",
        "sesskey": "abc123",
        "reindexall": "Reindex all active courses",
        "reindexallconfirm": "This will call the embedding API. Continue?",
        "reindexalldesc": "Only new or changed content is re-embedded.",
        "indexstatus": "Per-course index status",
        "nocourses": "No indexed courses and no active courses found.",
        "hascourses": true,
        "colcourse": "Course",
        "colchunks": "Chunks",
        "colembedded": "Embedded",
        "collastindexed": "Last indexed",
        "colactions": "Actions",
        "never": "Never",
        "reindex": "Reindex",
        "clearindex": "Clear index",
        "clearconfirm": "Delete all indexed chunks for this course?",
        "courses": [{
            "id": 2, "fullname": "Test Course 101",
            "courseurl": "https://example.org/course/view.php?id=2",
            "chunks": "12", "haschunks": true,
            "embedded": "12", "hasembedded": true,
            "lastindexed": "20/08/26, 14:03", "hasindexed": true
        }],
        "migration": {"configured": false}
    }
}}
<div class="sola-ragadmin">
    <div class="mb-2">
        <a href="{{backurl}}" class="btn btn-sm btn-outline-secondary mb-3">&larr; {{backlabel}}</a>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h4 class="mb-2">{{sourcestitle}}</h4>
            <p class="text-muted sola-ragadmin__hint">{{{sourcesdesc}}}</p>
            <table class="table table-sm mb-0">
                <tbody>
                    {{#statusrows}}
                        <tr>
                            <td class="sola-ragadmin__srclabel">{{label}}</td>
                            <td class="sola-ragadmin__srcstate">
                                {{#ok}}<span class="badge sola-ragadmin__badge sola-ragadmin__badge--ready">{{statelabel}}</span>{{/ok}}
                                {{^ok}}<span class="badge sola-ragadmin__badge sola-ragadmin__badge--off">{{statelabel}}</span>{{/ok}}
                            </td>
                            <td class="sola-ragadmin__srcdetail">{{{detail}}}</td>
                        </tr>
                    {{/statusrows}}
                </tbody>
            </table>
        </div>
    </div>

    <div class="row mb-4">
        {{#statcards}}
            <div class="col-md-3">
                <div class="card text-center">
                    <div class="card-body">
                        <p class="card-title h3 mb-1">{{value}}</p>
                        <p class="card-text text-muted mb-0">{{label}}</p>
                    </div>
                </div>
            </div>
        {{/statcards}}
    </div>

    {{#storageprojection}}
        <p class="text-muted sola-ragadmin__storagenote">{{.}}</p>
    {{/storageprojection}}

    {{^migration.configured}}
        <div class="card mb-4">
            <div class="card-body">
                <h4 class="mb-2">{{migration.heading}}</h4>
                <p class="text-muted mb-0">{{migration.notarget}}</p>
            </div>
        </div>
    {{/migration.configured}}

    {{#migration.configured}}
        {{! ---------------------------------------------------------------
            v7.4.0 embedding-model migration. One queued task per course; the
            new vectors are written alongside the old ones, so the index keeps
            serving until an administrator changes the live settings.
        --------------------------------------------------------------- }}
        <div class="card mb-4 sola-ragadmin__migration">
            <div class="card-body">
                <h4 class="mb-2">{{migration.heading}}</h4>
                <p class="text-muted">{{migration.desc}}</p>
                <p>{{{migration.summary}}}</p>
                {{#migration.sameaslive}}
                    <p class="text-muted">{{.}}</p>
                {{/migration.sameaslive}}
                <p><strong>{{migration.progress}}</strong></p>
                {{#migration.allcomplete}}
                    <div class="alert alert-success" role="alert">{{.}}</div>
                {{/migration.allcomplete}}

                <form method="post" action="{{posturl}}" class="mb-3"
                      data-confirm="{{migration.queueallconfirm}}">
                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                    <input type="hidden" name="action" value="migrateall">
                    <button type="submit" class="btn btn-primary">{{migration.queueall}}</button>
                </form>

                {{#migration.hasrows}}
                    <div class="table-responsive">
                        <table class="table table-sm generaltable mb-0">
                            <thead>
                                <tr>
                                    <th>{{migration.colcourse}}</th>
                                    <th class="text-right">{{migration.colchunks}}</th>
                                    <th class="text-right">{{migration.colmigrated}}</th>
                                    <th>{{migration.colstate}}</th>
                                    <th>{{migration.colactions}}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {{#migration.rows}}
                                    <tr>
                                        <td>{{fullname}}</td>
                                        <td class="text-right">{{chunks}}</td>
                                        <td class="text-right">{{migrated}}</td>
                                        <td>
                                            {{#complete}}<span class="badge badge-success">{{statelabel}}</span>{{/complete}}
                                            {{#pending}}<span class="badge badge-info">{{statelabel}}</span>{{/pending}}
                                            {{^complete}}{{^pending}}
                                                <span class="badge badge-warning">{{statelabel}}</span>
                                            {{/pending}}{{/complete}}
                                        </td>
                                        <td>
                                            {{#canqueue}}
                                                <form method="post" action="{{posturl}}" class="d-inline">
                                                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                                                    <input type="hidden" name="action" value="migrateone">
                                                    <input type="hidden" name="courseid" value="{{id}}">
                                                    <button type="submit" class="btn btn-sm btn-outline-primary">
                                                        {{migration.queueone}}
                                                    </button>
                                                </form>
                                            {{/canqueue}}
                                        </td>
                                    </tr>
                                {{/migration.rows}}
                            </tbody>
                        </table>
                    </div>
                {{/migration.hasrows}}

                <h5 class="mt-4">{{migration.purgeheading}}</h5>
                {{#migration.haspurge}}
                    <p class="text-muted">{{migration.purgedesc}}</p>
                    <form method="post" action="{{posturl}}" data-confirm="{{migration.purgeconfirm}}">
                        <input type="hidden" name="sesskey" value="{{sesskey}}">
                        <input type="hidden" name="action" value="migratepurge">
                        <button type="submit" class="btn btn-outline-danger btn-sm">{{migration.purge}}</button>
                    </form>
                {{/migration.haspurge}}
                {{^migration.haspurge}}
                    <p class="text-muted mb-0">{{migration.purgenone}}</p>
                {{/migration.haspurge}}

                <h5 class="mt-4">{{migration.faqheading}}</h5>
                <p class="text-muted">{{migration.faqstate}}</p>
                {{#migration.faqstale}}
                    <div class="alert alert-warning" role="alert">{{.}}</div>
                {{/migration.faqstale}}
                <form method="post" action="{{posturl}}">
                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                    <input type="hidden" name="action" value="faqreembed">
                    <button type="submit" class="btn btn-outline-secondary btn-sm">{{migration.faqreembed}}</button>
                </form>
            </div>
        </div>
    {{/migration.configured}}

    <form method="post" action="{{posturl}}" class="mb-4" data-confirm="{{reindexallconfirm}}">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <input type="hidden" name="action" value="reindexall">
        <button type="submit" class="btn btn-primary">{{reindexall}}</button>
        <small class="text-muted ml-2">{{reindexalldesc}}</small>
    </form>

    <h4>{{indexstatus}}</h4>

    {{^hascourses}}
        <p class="text-muted">{{nocourses}}</p>
    {{/hascourses}}
    {{#hascourses}}
        <table class="table table-sm generaltable">
            <thead>
                <tr>
                    <th>{{colcourse}}</th>
                    <th class="text-right">{{colchunks}}</th>
                    <th class="text-right">{{colembedded}}</th>
                    <th>{{collastindexed}}</th>
                    <th>{{colactions}}</th>
                </tr>
            </thead>
            <tbody>
                {{#courses}}
                    <tr>
                        <td><a href="{{courseurl}}" target="_blank">{{fullname}}</a></td>
                        <td class="text-right">
                            {{#haschunks}}<span class="badge badge-info">{{chunks}}</span>{{/haschunks}}
                            {{^haschunks}}<span class="badge badge-secondary">{{chunks}}</span>{{/haschunks}}
                        </td>
                        <td class="text-right">
                            {{#hasembedded}}<span class="badge badge-success">{{embedded}}</span>{{/hasembedded}}
                            {{^hasembedded}}<span class="badge badge-secondary">{{embedded}}</span>{{/hasembedded}}
                        </td>
                        <td>
                            {{#hasindexed}}{{lastindexed}}{{/hasindexed}}
                            {{^hasindexed}}<span class="text-muted">{{never}}</span>{{/hasindexed}}
                        </td>
                        <td>
                            <form method="post" action="{{posturl}}" class="d-inline">
                                <input type="hidden" name="sesskey" value="{{sesskey}}">
                                <input type="hidden" name="action" value="reindexcourse">
                                <input type="hidden" name="courseid" value="{{id}}">
                                <button type="submit" class="btn btn-sm btn-outline-primary">{{reindex}}</button>
                            </form>
                            {{#haschunks}}
                                <form method="post" action="{{posturl}}" class="d-inline ml-1" data-confirm="{{clearconfirm}}">
                                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                                    <input type="hidden" name="action" value="deleteindex">
                                    <input type="hidden" name="courseid" value="{{id}}">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">{{clearindex}}</button>
                                </form>
                            {{/haschunks}}
                        </td>
                    </tr>
                {{/courses}}
            </tbody>
        </table>
    {{/hascourses}}
</div>
{{#js}}
// Every destructive form carries its prompt in data-confirm, which keeps the
// handler out of an inline onclick attribute. window.confirm() is not available
// to us -- Moodle's ESLint forbids it (no-alert) -- so this uses the core
// save/cancel modal, which is also the accessible, themeable option.
require(['core/notification', 'core/str'], function(Notification, Str) {
    var forms = document.querySelectorAll('.sola-ragadmin form[data-confirm]');
    Array.prototype.forEach.call(forms, function(form) {
        var confirmed = false;
        form.addEventListener('submit', function(e) {
            if (confirmed) {
                return;
            }
            e.preventDefault();
            Str.get_strings([
                {key: 'confirm', component: 'moodle'},
                {key: 'yes', component: 'moodle'}
            ]).then(function(labels) {
                return Notification.saveCancelPromise(
                    labels[0],
                    form.dataset.confirm,
                    labels[1]
                );
            }).then(function() {
                confirmed = true;
                form.submit();
                return null;
            }).catch(function() {
                // Cancelled, or the modal failed to load: leave the form unsubmitted.
                return null;
            });
        });
    });
});
{{/js}}
