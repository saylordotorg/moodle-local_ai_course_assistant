{{!
    @template local_ai_course_assistant/analytics_tabs

    Analytics dashboard tabs for the SOLA reporting UI.
    All UI strings are resolved in PHP (analytics.php) and passed as str_* context.

    Example context (json):
    {
        "courses": [
            {
                "id": 2,
                "shortname": "TEST101"
            }
        ],
        "str_time_range": "Time Range",
        "str_last_7_days": "Last 7 days",
        "str_last_30_days": "Last 30 days",
        "str_last_90_days": "Last 90 days",
        "str_all_time": "All time",
        "str_course": "Course",
        "str_all_courses": "All courses",
        "str_tab_overall": "Overall Usage",
        "str_tab_bycourse": "By Course",
        "str_tab_comparison": "AI vs Non-Users",
        "str_tab_byunit": "By Unit",
        "str_tab_usagetypes": "Usage Types",
        "str_tab_themes": "Themes",
        "str_tab_feedback": "AI Feedback"
    }
}}
<div class="sola-analytics-dashboard mt-4">
    <div class="sola-analytics-filters d-flex align-items-center gap-3 mb-3 flex-wrap">
        <div>
            <label for="sola-analytics-range" class="form-label mb-0 small text-muted">{{str_time_range}}</label>
            <select id="sola-analytics-range" class="form-select form-select-sm" style="width:auto;">
                <option value="7">{{str_last_7_days}}</option>
                <option value="30" selected>{{str_last_30_days}}</option>
                <option value="90">{{str_last_90_days}}</option>
                <option value="0">{{str_all_time}}</option>
            </select>
        </div>
        <div>
            <label for="sola-analytics-course" class="form-label mb-0 small text-muted">{{str_course}}</label>
            <select id="sola-analytics-course" class="form-select form-select-sm" style="width:auto;">
                <option value="0">{{str_all_courses}}</option>
                {{#courses}}
                <option value="{{id}}">{{shortname}}</option>
                {{/courses}}
            </select>
        </div>
    </div>

    <ul class="nav nav-tabs sola-analytics-tabs mb-0">
        <li class="nav-item"><a href="#" class="nav-link sola-analytics-tab active" data-tab="overall">{{str_tab_overall}}</a></li>
        <li class="nav-item"><a href="#" class="nav-link sola-analytics-tab" data-tab="bycourse">{{str_tab_bycourse}}</a></li>
        <li class="nav-item"><a href="#" class="nav-link sola-analytics-tab" data-tab="comparison">{{str_tab_comparison}}</a></li>
        <li class="nav-item"><a href="#" class="nav-link sola-analytics-tab" data-tab="byunit">{{str_tab_byunit}}</a></li>
        <li class="nav-item"><a href="#" class="nav-link sola-analytics-tab" data-tab="usagetypes">{{str_tab_usagetypes}}</a></li>
        <li class="nav-item"><a href="#" class="nav-link sola-analytics-tab" data-tab="themes">{{str_tab_themes}}</a></li>
        <li class="nav-item"><a href="#" class="nav-link sola-analytics-tab" data-tab="feedback">{{str_tab_feedback}}</a></li>
    </ul>

    <div class="sola-analytics-panes border border-top-0 rounded-bottom p-4 bg-white">
        <div id="sola-pane-overall" class="sola-analytics-pane"><div class="sola-analytics-content"></div></div>
        <div id="sola-pane-bycourse" class="sola-analytics-pane" style="display:none;"><div class="sola-analytics-content"></div></div>
        <div id="sola-pane-comparison" class="sola-analytics-pane" style="display:none;"><div class="sola-analytics-content"></div></div>
        <div id="sola-pane-byunit" class="sola-analytics-pane" style="display:none;"><div class="sola-analytics-content"></div></div>
        <div id="sola-pane-usagetypes" class="sola-analytics-pane" style="display:none;"><div class="sola-analytics-content"></div></div>
        <div id="sola-pane-themes" class="sola-analytics-pane" style="display:none;"><div class="sola-analytics-content"></div></div>
        <div id="sola-pane-feedback" class="sola-analytics-pane" style="display:none;"><div class="sola-analytics-content"></div></div>
    </div>
</div>
