{{!
    Token usage and cost analytics page — admin only.

    @template local_ai_course_assistant/token_analytics

    Example context (json):
    {
        "analytics_url": "#",
        "url_7": "#",
        "url_30": "#",
        "url_90": "#",
        "url_all": "#",
        "range": "30",
        "range_7_active": false,
        "range_30_active": true,
        "range_90_active": false,
        "range_all_active": false,
        "courses": [
            {
                "id": 2,
                "name": "Test Course 101",
                "selected": true
            }
        ],
        "grand_responses": "128",
        "grand_prompt": "15420",
        "grand_completion": "9280",
        "grand_total_tokens": "24700",
        "grand_cost": "$1.82",
        "has_by_model": true,
        "by_model": [
            {
                "model": "gpt-4.1-mini",
                "provider": "OpenAI",
                "response_count": 128,
                "prompt_tokens": 15420,
                "completion_tokens": 9280,
                "total_tokens": 24700,
                "cost_unknown": false,
                "estimated_cost": "$1.82"
            }
        ],
        "has_missing": true,
        "missing_count": 3,
        "has_by_student": true,
        "by_student": [
            {
                "name": "Alex Student",
                "response_count": 24,
                "prompt_tokens": 2980,
                "completion_tokens": 1820,
                "total_tokens": 4800,
                "estimated_cost": "$0.36"
            }
        ],
        "rate_cards": [
            {
                "model": "gpt-4.1-mini",
                "input_per_1m": "$0.40",
                "output_per_1m": "$1.60"
            }
        ]
    }
}}

<div class="aica-cost-page">

    <div class="aica-cost-nav">
        <a href="{{analytics_url}}">&larr; {{str_back}}</a>
        <span style="color:#d1d5db">|</span>
        <strong style="font-size:20px;color:#111827">{{str_heading}}</strong>
    </div>

    {{! ── Filters ─────────────────────────────────────────────────────────── }}
    <div class="aica-cost-filters">
        <span class="aica-cost-filter-label">{{str_period}}</span>
        <a href="{{url_7}}"  class="aica-cost-range-btn {{#range_7_active}}active{{/range_7_active}}">{{str_range_7}}</a>
        <a href="{{url_30}}" class="aica-cost-range-btn {{#range_30_active}}active{{/range_30_active}}">{{str_range_30}}</a>
        <a href="{{url_90}}" class="aica-cost-range-btn {{#range_90_active}}active{{/range_90_active}}">{{str_range_90}}</a>
        <a href="{{url_all}}" class="aica-cost-range-btn {{#range_all_active}}active{{/range_all_active}}">{{str_range_all}}</a>
        &nbsp;
        <label for="aica-course-select">{{str_course}}</label>
        <select id="aica-course-select" onchange="window.location=this.value">
            {{#courses}}
            <option value="/local/ai_course_assistant/token_analytics.php?range={{../range}}&amp;courseid={{id}}"
                {{#selected}}selected{{/selected}}>{{name}}</option>
            {{/courses}}
        </select>
    </div>

    {{! ── Summary cards ───────────────────────────────────────────────────── }}
    <div class="aica-cost-cards">
        <div class="aica-cost-card">
            <div class="aica-cost-card__label">{{str_card_responses}}</div>
            <div class="aica-cost-card__value">{{grand_responses}}</div>
        </div>
        <div class="aica-cost-card">
            <div class="aica-cost-card__label">{{str_card_prompt}}</div>
            <div class="aica-cost-card__value">{{grand_prompt}}</div>
        </div>
        <div class="aica-cost-card">
            <div class="aica-cost-card__label">{{str_card_completion}}</div>
            <div class="aica-cost-card__value">{{grand_completion}}</div>
        </div>
        <div class="aica-cost-card">
            <div class="aica-cost-card__label">{{str_card_total}}</div>
            <div class="aica-cost-card__value">{{grand_total_tokens}}</div>
        </div>
        <div class="aica-cost-card aica-cost-card--highlight">
            <div class="aica-cost-card__label">{{str_card_cost}}</div>
            <div class="aica-cost-card__value">{{grand_cost}}</div>
            {{#cost_partial}}
            <div class="aica-cost-card__warn text-warning small">{{cost_partial_note}}</div>
            {{/cost_partial}}
        </div>
        {{#has_cache_data}}
        <div class="aica-cost-card">
            <div class="aica-cost-card__label">{{str_card_cached}}</div>
            <div class="aica-cost-card__value">{{cached_tokens}}</div>
        </div>
        {{/has_cache_data}}
    </div>

    {{! ── Spend guard status (v3.9.9+) ─────────────────────────────────── }}
    {{#has_spend_status}}
    <div class="aica-cost-section">
        <div class="aica-cost-section__header">
            <p class="aica-cost-section__title">{{str_spend_title}}</p>
            <p class="aica-cost-section__sub">{{str_spend_sub}}</p>
        </div>
        <table class="aica-cost-table">
            <thead><tr>
                <th>{{str_col_scope}}</th>
                <th style="text-align:right">{{str_col_spent}}</th>
                <th style="text-align:right">{{str_col_cap}}</th>
                <th>{{str_col_status}}</th>
            </tr></thead>
            <tbody>
                {{#spend_status}}
                <tr>
                    <td><strong>{{label}}</strong></td>
                    <td class="num">{{spent_fmt}}</td>
                    <td class="num">{{cap_fmt}}</td>
                    <td>
                        {{#cap_is_set}}
                        <div style="display:flex;align-items:center;gap:10px">
                            <div style="flex:1;background:#e9ecef;border-radius:6px;height:8px;overflow:hidden;max-width:240px">
                                <div style="width:{{pct}}%;background:{{color}};height:100%"></div>
                            </div>
                            <span style="font-size:12px;color:{{color}};font-weight:600;white-space:nowrap">{{pct}}%</span>
                        </div>
                        {{/cap_is_set}}
                        {{^cap_is_set}}
                        <span class="text-muted" style="font-size:12px">{{str_no_cap}}</span>
                        {{/cap_is_set}}
                    </td>
                </tr>
                {{/spend_status}}
            </tbody>
        </table>
    </div>
    {{/has_spend_status}}

    {{! ── Optimizer recommendations (v3.9.9+) ──────────────────────────── }}
    <div class="aica-cost-section">
        <div class="aica-cost-section__header">
            <p class="aica-cost-section__title">{{str_opt_title}}</p>
            <p class="aica-cost-section__sub">{{{str_opt_sub}}}</p>
        </div>
        <table class="aica-cost-table">
            <thead><tr>
                <th>{{str_col_capability}}</th>
                <th>{{str_col_active}}</th>
                <th>{{str_col_recommendations}}</th>
            </tr></thead>
            <tbody>
                {{#opt_rows}}
                <tr>
                    <td><strong>{{capability}}</strong></td>
                    <td><code>{{active}}</code></td>
                    <td style="font-size:13px;line-height:1.6">{{{rankings_html}}}</td>
                </tr>
                {{/opt_rows}}
            </tbody>
        </table>
    </div>

    {{! ── By category (Chat / Voice / RAG / Analytics) ───────────────────── }}
    {{#has_by_category}}
    <div class="aica-cost-section">
        <div class="aica-cost-section__header">
            <p class="aica-cost-section__title">{{str_bycat_title}}</p>
            <p class="aica-cost-section__sub">{{str_bycat_sub}}</p>
        </div>
        <table class="aica-cost-table">
            <thead>
                <tr>
                    <th>{{str_col_category}}</th>
                    <th style="text-align:right">{{str_col_responses}}</th>
                    <th style="text-align:right">{{str_col_prompt_tokens}}</th>
                    <th style="text-align:right">{{str_col_completion_tokens}}</th>
                    <th style="text-align:right">{{str_col_total_tokens}}</th>
                </tr>
            </thead>
            <tbody>
                {{#by_category}}
                <tr>
                    <td><strong>{{category}}</strong></td>
                    <td class="num">{{response_count}}</td>
                    <td class="num">{{prompt_tokens}}</td>
                    <td class="num">{{completion_tokens}}</td>
                    <td class="num">{{total_tokens}}</td>
                </tr>
                {{/by_category}}
            </tbody>
        </table>
    </div>
    {{/has_by_category}}

    {{! ── By model ────────────────────────────────────────────────────────── }}
    <div class="aica-cost-section">
        <div class="aica-cost-section__header">
            <p class="aica-cost-section__title">{{str_bymodel_title}}</p>
            <p class="aica-cost-section__sub">{{str_bymodel_sub}}</p>
        </div>
        {{#has_by_model}}
        <table class="aica-cost-table">
            <thead>
                <tr>
                    <th>{{str_col_model}}</th>
                    <th>{{str_col_provider}}</th>
                    <th style="text-align:right">{{str_col_responses}}</th>
                    <th style="text-align:right">{{str_col_prompt_tokens}}</th>
                    <th style="text-align:right">{{str_col_completion_tokens}}</th>
                    <th style="text-align:right">{{str_col_total_tokens}}</th>
                    <th style="text-align:right">{{str_col_est_cost}}</th>
                </tr>
            </thead>
            <tbody>
                {{#by_model}}
                <tr>
                    <td><code>{{model}}</code></td>
                    <td>{{provider}}</td>
                    <td class="num">{{response_count}}</td>
                    <td class="num">{{prompt_tokens}}</td>
                    <td class="num">{{completion_tokens}}</td>
                    <td class="num">{{total_tokens}}</td>
                    <td class="{{#cost_unknown}}unknown{{/cost_unknown}}{{^cost_unknown}}cost{{/cost_unknown}}">
                        {{estimated_cost}}
                    </td>
                </tr>
                {{/by_model}}
            </tbody>
        </table>
        {{/has_by_model}}
        {{^has_by_model}}
        <p class="aica-cost-empty">{{str_no_data_tracking}}</p>
        {{/has_by_model}}
        {{#has_missing}}
        <div class="aica-cost-alert">
            &#9888; {{{str_missing_note}}}
        </div>
        {{/has_missing}}
    </div>

    {{! ── Talking-avatar cost (v4.10.0) ─────────────────────────────────── }}
    <div class="aica-cost-section">
        <div class="aica-cost-section__header">
            <p class="aica-cost-section__title">{{#str}}analytics:avatar_cost_heading, local_ai_course_assistant{{/str}}</p>
            <p class="aica-cost-section__sub">{{str_avatar_sub}}</p>
        </div>
        {{#avatar_has_rows}}
        <table class="aica-cost-table">
            <thead>
                <tr>
                    <th>{{#str}}analytics:avatar_cost_provider, local_ai_course_assistant{{/str}}</th>
                    <th class="num">{{#str}}analytics:avatar_cost_sessions, local_ai_course_assistant{{/str}}</th>
                    <th class="num">{{#str}}analytics:avatar_cost_minutes, local_ai_course_assistant{{/str}}</th>
                    <th class="num">{{#str}}analytics:avatar_cost_rate, local_ai_course_assistant{{/str}}</th>
                    <th class="num">{{#str}}analytics:avatar_cost_total, local_ai_course_assistant{{/str}}</th>
                </tr>
            </thead>
            <tbody>
                {{#avatar_rows}}
                <tr>
                    <td>{{provider}}</td>
                    <td class="num">{{sessions}}</td>
                    <td class="num">{{minutes}}</td>
                    <td class="num">{{rate}}</td>
                    <td class="num cost">{{cost}}</td>
                </tr>
                {{/avatar_rows}}
                <tr class="aica-cost-table__total">
                    <td>{{str_avatar_total_row}}</td>
                    <td class="num">{{avatar_grand_sessions}}</td>
                    <td class="num">{{avatar_grand_minutes}}</td>
                    <td></td>
                    <td class="num cost">{{avatar_grand_cost}}</td>
                </tr>
            </tbody>
        </table>
        {{/avatar_has_rows}}
        {{^avatar_has_rows}}
        <p class="aica-cost-empty">{{#str}}analytics:avatar_cost_empty, local_ai_course_assistant{{/str}}</p>
        {{/avatar_has_rows}}
    </div>

    {{! ── Per student ─────────────────────────────────────────────────────── }}
    <div class="aica-cost-section">
        <div class="aica-cost-section__header">
            <p class="aica-cost-section__title">{{str_bystudent_title}}</p>
            <p class="aica-cost-section__sub">{{str_bystudent_sub}}</p>
        </div>
        {{#has_by_student}}
        <table class="aica-cost-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>{{str_col_student}}</th>
                    <th style="text-align:right">{{str_col_responses}}</th>
                    <th style="text-align:right">{{str_col_prompt_tokens}}</th>
                    <th style="text-align:right">{{str_col_completion_tokens}}</th>
                    <th style="text-align:right">{{str_col_total_tokens}}</th>
                    <th style="text-align:right">{{str_col_est_cost}}</th>
                </tr>
            </thead>
            <tbody>
                {{#by_student}}
                <tr>
                    <td style="color:#9ca3af;font-size:11px">{{@index_1}}</td>
                    <td>{{name}}</td>
                    <td class="num">{{response_count}}</td>
                    <td class="num">{{prompt_tokens}}</td>
                    <td class="num">{{completion_tokens}}</td>
                    <td class="num">{{total_tokens}}</td>
                    <td class="cost">{{estimated_cost}}</td>
                </tr>
                {{/by_student}}
            </tbody>
        </table>
        {{/has_by_student}}
        {{^has_by_student}}
        <p class="aica-cost-empty">{{str_no_data}}</p>
        {{/has_by_student}}
    </div>

    {{! ── Rate card reference ─────────────────────────────────────────────── }}
    <div class="aica-cost-section">
        <div class="aica-cost-section__header">
            <p class="aica-cost-section__title">{{str_ratecard_title}}</p>
            <p class="aica-cost-section__sub">{{{str_ratecard_sub}}}</p>
        </div>
        <div class="aica-rate-grid">
            {{#rate_cards}}
            <div class="aica-rate-item">
                <span class="aica-rate-item__model">{{model}}</span>
                <span class="aica-rate-item__price">{{price_label}}</span>
            </div>
            {{/rate_cards}}
        </div>
    </div>

</div>
