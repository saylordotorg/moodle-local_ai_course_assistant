{{!
    @template local_ai_course_assistant/soapbox_present

    Soapbox presentation assignment learner page: intro, topic picker,
    recorder widget (video or audio-only, optional slide deck), and the
    learner's past-attempts table. All user-facing strings are resolved in
    PHP and passed in as data; ids/classes are bound by the
    soapbox_present/soapbox_recorder/soapbox_player AMD modules and must
    not change.

    @package    local_ai_course_assistant
    @copyright  2026 Saylor Academy
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later

    Example context (json):
    {
        "hasintro": true,
        "introhtml": "<p>Give a short persuasive talk.</p>",
        "modelabel": "Record a video presentation",
        "ptype": "Persuasive",
        "targetlabel": "Aim for 2-5 minutes",
        "hastopics": true,
        "choosetopic": "Choose your topic",
        "topics": [
            {"id": 3, "title": "Renewable energy"}
        ],
        "topicdetails": [
            {"title": "Renewable energy", "instructions": "<p>Argue for or against.</p>"}
        ],
        "storageready": true,
        "storagewarninghtml": "",
        "modeclass": "sbx-mode-video",
        "isaudio": false,
        "isvideo": true,
        "slidesenabled": true,
        "decklabel": "Slide deck (PDF)",
        "audioready": "Microphone ready",
        "recordlabel": "Record",
        "stoplabel": "Stop",
        "recordingsheadinghtml": "<h4>My recordings</h4>",
        "hasrecordings": true,
        "norecordingstext": "No recordings yet.",
        "colrecorded": "Recorded",
        "collength": "Length",
        "colstatus": "Status",
        "viewlabel": "View / download",
        "playlabel": "Play with slides",
        "expiredlabel": "Expired",
        "recordings": [
            {
                "recorded": "6/09/26, 14:00",
                "length": "03:12",
                "status": "Scored",
                "viewurl": "https://example.com/presigned",
                "hasplay": true,
                "recid": 12,
                "expired": false
            }
        ],
        "retentionnote": "Recordings are kept for 90 days."
    }
}}
{{#hasintro}}
<div class="sbx-intro mb-3">{{{introhtml}}}</div>
{{/hasintro}}

<div class="sbx-meta text-muted mb-3">{{{modelabel}}} &middot; {{ptype}} &middot; {{{targetlabel}}}</div>

{{#hastopics}}
<div class="sbx-topics mb-3">
    <label for="sbx-topic" class="font-weight-bold d-block">{{{choosetopic}}}</label>
    <select class="select custom-select menusbx-topic" id="sbx-topic" name="sbx-topic">
        {{#topics}}
        <option value="{{id}}">{{{title}}}</option>
        {{/topics}}
    </select>
    {{#topicdetails}}
    <div class="sbx-topic-detail small text-muted mt-2"><strong>{{{title}}}: </strong>{{{instructions}}}</div>
    {{/topicdetails}}
</div>
{{/hastopics}}

{{^storageready}}
{{{storagewarninghtml}}}
{{/storageready}}
{{#storageready}}
<div class="sbx-howto card p-3 mb-3">
    <h5 class="mt-0">{{{howtoheading}}}</h5>
    <ul class="mb-2">
        {{#howto}}
        <li>{{{text}}}</li>
        {{/howto}}
    </ul>
    <div class="alert alert-info mb-0" role="note">
        <strong>{{retentionheading}}</strong>
        <span>{{retentionline}}</span>
    </div>
    <p class="small text-muted mb-0 mt-2">{{{privacynote}}}</p>
</div>
<div class="sbx-recorder card p-3 mb-4 {{modeclass}}" id="sbx-recorder">
    {{#slidesenabled}}
    <div class="sbx-deck mb-3">
        <label for="sbx-deck-input" class="font-weight-bold d-block">{{{decklabel}}}</label>
        <input type="file" accept="application/pdf,.pdf" id="sbx-deck-input" class="sbx-deck-input form-control-file" />
        <div class="sbx-deck-status small text-muted mt-1"></div>
        <div class="sbx-slide-viewer mt-2" style="max-width:640px"></div>
    </div>
    {{/slidesenabled}}
    {{#isvideo}}
    <video class="sbx-preview w-100 mb-2" playsinline="playsinline" style="max-height:360px;background:#000;border-radius:6px"></video>
    {{/isvideo}}
    {{#isaudio}}
    <div class="sbx-audio-indicator d-flex align-items-center mb-2" style="gap:10px"><span class="sbx-mic-dot"></span><span class="sbx-mic-label">{{{audioready}}}</span></div>
    {{/isaudio}}
    <div class="sbx-controls d-flex align-items-center mb-2" style="gap:12px">
        <button type="button" class="sbx-record btn btn-primary">{{{recordlabel}}}</button>
        <button type="button" class="sbx-stop btn btn-outline-secondary">{{{stoplabel}}}</button>
        <span class="sbx-timer font-weight-bold">0:00</span>
    </div>
    <div class="sbx-status text-muted"></div>
    <div class="sbx-result mt-2"></div>
</div>
{{/storageready}}

{{{recordingsheadinghtml}}}
{{^hasrecordings}}
<div class="text-muted">{{{norecordingstext}}}</div>
{{/hasrecordings}}
{{#hasrecordings}}
<table class="generaltable">
    <thead>
        <tr>
            <th>{{{colrecorded}}}</th>
            <th>{{{collength}}}</th>
            <th>{{{colstatus}}}</th>
            <th>{{{coldeletes}}}</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        {{#recordings}}
        <tr>
            <td>{{recorded}}</td>
            <td>{{length}}</td>
            <td>{{{status}}}</td>
            <td>{{deleteson}}</td>
            <td>{{#viewurl}}<a href="{{viewurl}}" target="_blank" rel="noopener">{{{watchlabel}}}</a>{{/viewurl}}{{#downloadurl}} &middot; <a href="{{downloadurl}}" download aria-label="{{{downloadaria}}}">{{{downloadlabel}}}</a>{{/downloadurl}}{{#hasplay}} &middot; <button type="button" class="sbx-play-btn btn btn-link btn-sm p-0" data-recid="{{recid}}">{{{playlabel}}}</button>{{/hasplay}}{{#expired}}<span class="text-muted">{{{expiredlabel}}}</span>{{/expired}}</td>
        </tr>
        <tr class="sbx-fb-row">
            <td colspan="5" class="pt-0">
                <details class="sbx-fb">
                    <summary class="small">{{{feedbacktoggle}}}</summary>
                    {{#hasfeedback}}
                    <table class="table table-sm mt-2 mb-1">
                        <thead>
                            <tr>
                                <th>{{{colcriterion}}}</th>
                                <th>{{{colscore}}}</th>
                                <th>{{{colfeedback}}}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#criteria}}
                            <tr class="{{^assessed}}text-muted{{/assessed}}">
                                <td>{{name}}</td>
                                <td>{{#assessed}}{{score}}{{/assessed}}{{^assessed}}<span class="badge badge-secondary" title="{{notassessedaria}}">{{notassessed}}</span>{{/assessed}}</td>
                                <td>{{feedback}}</td>
                            </tr>
                            {{/criteria}}
                        </tbody>
                    </table>
                    <p class="small text-muted mb-1">{{{scoredon}}}</p>
                    {{#overall}}<p class="mb-1">{{overall}}</p>{{/overall}}
                    {{#hastips}}
                    <ul class="small mb-0">
                        {{#tips}}<li>{{text}}</li>{{/tips}}
                    </ul>
                    {{/hastips}}
                    {{/hasfeedback}}
                    {{^hasfeedback}}
                    <p class="small text-muted mt-2 mb-0">{{{feedbackpending}}}</p>
                    {{/hasfeedback}}
                </details>
            </td>
        </tr>
        {{/recordings}}
    </tbody>
</table>
<div class="sbx-playback mt-3" id="sbx-playback"></div>
<div class="small text-muted mt-1">{{{retentionnote}}}</div>
{{/hasrecordings}}
